{#
  CSS shared by the four concept layouts: canvas, palette defaults, type helpers,
  and the small parts every layout uses (monogram, buttons, concept tag, stars,
  empty reviews, booking chips, form fields, chat bubble).
  Layout-specific CSS lives in each _concept_vN.html.j2. All sizes are px.

  Palette rules the layouts rely on:
    --cx-primary  dark enough for white text
    --cx-dark     darker still; used for big dark areas and for text on tint
    --cx-tint     very light; used as a page background
    --cx-accent   any mid-lightness hue; shapes and marks only, never a text background
                  for white text (text on accent uses --cx-dark)
#}
<style>
  html, body { margin: 0; padding: 0; width: 1440px; height: 1800px; overflow: hidden; background: #fff; }

  .cx {
    --cx-primary: #1D4ED8;
    --cx-dark: #1E3A8A;
    --cx-tint: #EFF6FF;
    --cx-accent: #F59E0B;
    --cx-ink: #16181D;
    --cx-body: #3F4553;
    --cx-muted: #5A6170;
    --cx-line: #E3E5EA;
    --cx-sans: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
    --cx-serif: Georgia, Cambria, "Times New Roman", "DejaVu Serif", serif;
    position: relative;
    display: flex;
    flex-direction: column;
    width: 1440px;
    height: 1800px;
    overflow: hidden;
    background: #fff;
    color: var(--cx-ink);
    font-family: var(--cx-sans);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .cx, .cx *, .cx *::before, .cx *::after { box-sizing: border-box; }
  .cx * { margin: 0; padding: 0; border: 0; font: inherit; color: inherit; }
  .cx svg, .cx img { display: block; }

  /* Text that must never push a layout out of shape */
  .cx-one-line { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .cx-clamp-2, .cx-clamp-3, .cx-clamp-4 { display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: break-word; }
  .cx-clamp-2 { -webkit-line-clamp: 2; }
  .cx-clamp-3 { -webkit-line-clamp: 3; }
  .cx-clamp-4 { -webkit-line-clamp: 4; }

  .cx-ico { width: 1em; height: 1em; flex: none; fill: currentColor; }
  .cx-ico-line { fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

  .cx-photo { width: 100%; height: 100%; object-fit: cover; }
  .cx-f-primary { fill: var(--cx-primary); }
  .cx-f-dark { fill: var(--cx-dark); }
  .cx-f-tint { fill: var(--cx-tint); }
  .cx-f-accent { fill: var(--cx-accent); }
  .cx-f-white { fill: #fff; }
  .cx-f-none { fill: none; }
  .cx-s-dark { stroke: var(--cx-dark); }
  .cx-s-primary { stroke: var(--cx-primary); }
  .cx-s-accent { stroke: var(--cx-accent); }
  .cx-s-white { stroke: #fff; }

  /* Concept tag */
  .cx-tag {
    position: absolute; right: 0; z-index: 8;
    max-width: 640px;
    padding: 8px 18px 9px 16px;
    border-radius: 9px 0 0 9px;
    background: #16181D; color: #fff;
    font-family: var(--cx-sans); font-size: 13.5px; font-weight: 600; line-height: 1.3;
    box-shadow: 0 0 0 1.5px rgba(255, 255, 255, .7);
  }

  /* Monogram */
  .cx-mono {
    flex: none; width: 46px; height: 46px; border-radius: 13px;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
    background: var(--cx-primary); color: #fff;
    font-family: var(--cx-sans); font-size: 18px; font-weight: 700; letter-spacing: .02em; white-space: nowrap;
  }
  .cx-mono-small { font-size: 13px; letter-spacing: 0; }

  /* Buttons */
  .cx-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; flex: none;
    height: 58px; padding: 0 30px; border-radius: 14px;
    background: var(--cx-primary); color: #fff;
    font-family: var(--cx-sans); font-size: 18px; font-weight: 600; white-space: nowrap;
  }
  .cx-btn-sm { height: 50px; padding: 0 24px; border-radius: 12px; font-size: 16.5px; }
  .cx-btn-white { background: #fff; color: var(--cx-dark); }
  .cx-btn-dark { background: var(--cx-dark); color: #fff; }
  .cx-btn-line { background: transparent; color: #fff; box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, .7); }

  /* Rating stars */
  .cx-stars { position: relative; width: 5em; height: 1em; font-size: 28px; }
  .cx-stars-row { display: flex; width: 5em; }
  .cx-stars-base { opacity: .24; }
  .cx-stars-fill { position: absolute; left: 0; top: 0; overflow: hidden; color: var(--cx-accent); }

  /* Empty review */
  .cx-quote { padding: 20px 22px; border: 1.5px dashed rgba(127, 127, 127, .5); border-radius: 18px; }
  .cx-bar { height: 10px; border-radius: 5px; background: currentColor; opacity: .2; }
  .cx-bar + .cx-bar { margin-top: 11px; }
  .cx-bar-80 { width: 80%; }
  .cx-bar-55 { width: 55%; }
  .cx-quote-who { display: flex; align-items: center; gap: 10px; margin-top: 18px; }
  .cx-quote-face { width: 26px; height: 26px; border-radius: 50%; background: currentColor; opacity: .2; }
  .cx-quote-name { width: 96px; height: 9px; border-radius: 5px; background: currentColor; opacity: .14; }

  /* Booking chips and form fields */
  .cx-pick {
    display: flex; align-items: center; justify-content: center; height: 46px; min-width: 0;
    border-radius: 12px; background: #fff; box-shadow: inset 0 0 0 1.5px var(--cx-line);
    color: #3B4150; font-family: var(--cx-sans); font-size: 15.5px; font-weight: 600; white-space: nowrap;
  }
  .cx-pick-on { background: var(--cx-primary); box-shadow: none; color: #fff; }
  .cx-pick-soft { background: var(--cx-tint); box-shadow: inset 0 0 0 1.5px var(--cx-primary); color: var(--cx-dark); }
  .cx-field {
    display: flex; align-items: center; height: 50px; min-width: 0; padding: 0 16px;
    border-radius: 12px; background: #fff; box-shadow: inset 0 0 0 1.5px var(--cx-line);
    color: #7A8090; font-family: var(--cx-sans); font-size: 16px; white-space: nowrap; overflow: hidden;
  }
  .cx-field-tall { height: 100px; align-items: flex-start; padding-top: 12px; }

  /* Chat bubble */
  .cx-chat { position: absolute; right: 44px; bottom: 22px; z-index: 7; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; font-family: var(--cx-sans); }
  .cx-chat-note {
    padding: 12px 18px; border-radius: 16px 16px 4px 16px; background: #fff; color: var(--cx-ink);
    box-shadow: 0 16px 36px -16px rgba(20, 24, 40, .5), 0 0 0 1px rgba(20, 24, 40, .07);
    font-size: 15.5px; font-weight: 600; white-space: nowrap;
  }
  .cx-chat-btn {
    width: 66px; height: 66px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--cx-primary); color: #fff; font-size: 30px;
    box-shadow: 0 0 0 4px #fff, 0 14px 30px -10px rgba(20, 24, 40, .55);
  }
</style>
