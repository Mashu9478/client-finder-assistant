{#
  Concept layout 1: full-bleed hero (photo, or shapes in the palette) with the
  header and headline laid over it and the booking card inside it; an info strip
  with the address and phone; services as a ruled list; reviews on the tint;
  a one-line enquiry band in the brand colour; light footer.
#}
{% import "_concept_ui.html.j2" as ui %}
{% set card = 'booking' if cxf.booking else ('enquiry' if cxf.enquiry_form else '') %}
{% set form_band = cxf.booking and cxf.enquiry_form %}
<style>
  .cx-v1 .cx-tag { top: 112px; background: #fff; color: var(--cx-ink); box-shadow: 0 6px 18px -8px rgba(0, 0, 0, .5); }

  /* The enquiry band sits right above the footer here, so the chat shows as the bubble alone. */
  .cx-v1 .cx-chat-note { display: none; }

  .v1-hero { position: relative; flex: 2 1 auto; min-height: 0; display: flex; flex-direction: column; overflow: hidden; background: var(--cx-dark); color: #fff; }
  .v1-bg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .v1-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--cx-dark) 62%, transparent) 0, transparent 170px),
      linear-gradient(90deg, color-mix(in srgb, var(--cx-dark) 90%, transparent) 0%, color-mix(in srgb, var(--cx-dark) 62%, transparent) 40%, color-mix(in srgb, var(--cx-dark) 6%, transparent) 78%, transparent 100%);
  }
  .v1-top { position: relative; flex: none; height: 96px; display: flex; align-items: center; gap: 36px; padding: 0 80px; }
  .v1-brand { display: flex; align-items: center; gap: 14px; min-width: 280px; flex: 0 1 auto; }
  .v1-top .cx-mono { background: #fff; color: var(--cx-dark); }
  .v1-name { max-width: 420px; font-size: 21px; font-weight: 600; letter-spacing: -.01em; }
  .v1-nav { flex: 0 1 auto; min-width: 0; display: flex; align-items: center; gap: 32px; margin-left: auto; }
  .v1-nav > div { flex: 0 1 auto; min-width: 0; max-width: 190px; color: rgba(255, 255, 255, .9); font-size: 16px; font-weight: 500; }
  .v1-call { flex: none; display: flex; align-items: center; gap: 10px; max-width: 270px; height: 46px; padding: 0 20px; border-radius: 999px; background: #fff; color: var(--cx-dark); font-size: 16px; font-weight: 600; }
  .v1-call .cx-ico { color: var(--cx-primary); font-size: 17px; }
  .v1-top-end { margin-left: auto; }

  .v1-body { position: relative; flex: 1 1 auto; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) 440px; align-items: end; column-gap: 72px; padding: 36px 80px 68px; }
  .v1-body-solo { grid-template-columns: minmax(0, 1fr); }
  .v1-kicker { display: flex; align-items: center; gap: 16px; margin-bottom: 22px; min-width: 0; }
  .v1-chip { flex: none; max-width: 300px; padding: 6px 15px 7px; border-radius: 999px; box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, .7); font-size: 15px; font-weight: 600; }
  .v1-where { display: flex; align-items: center; gap: 7px; min-width: 0; color: rgba(255, 255, 255, .9); font-size: 15.5px; }
  .v1-h1 { max-width: 760px; padding-bottom: 6px; font-weight: 700; }
  .v1-h1-xl { font-size: 84px; line-height: 1.02; letter-spacing: -.03em; }
  .v1-h1-l { font-size: 66px; line-height: 1.05; letter-spacing: -.026em; }
  .v1-h1-m { font-size: 52px; line-height: 1.1; letter-spacing: -.02em; }
  .v1-sub { max-width: 620px; margin-top: 20px; color: rgba(255, 255, 255, .92); font-size: 21px; line-height: 1.5; }
  .v1-sub-long { font-size: 18.5px; }
  .v1-actions { display: flex; align-items: center; gap: 16px; margin-top: 32px; }
  .v1-actions .cx-btn-line { max-width: 360px; }

  .v1-card { align-self: center; padding: 28px 30px 30px; border-radius: 26px; background: #fff; color: var(--cx-ink); box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .65); }
  .v1-card-title { font-size: 26px; font-weight: 700; line-height: 1.2; letter-spacing: -.015em; }
  .v1-card-text { margin-top: 4px; color: var(--cx-muted); font-size: 16px; }
  .v1-days { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-top: 18px; }
  .v1-slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 10px; }
  .v1-chosen { display: flex; align-items: center; gap: 12px; height: 48px; margin-top: 10px; padding: 0 16px; border-radius: 12px; background: var(--cx-tint); color: var(--cx-dark); font-size: 15.5px; font-weight: 600; }
  .v1-chosen .cx-ico { color: var(--cx-primary); font-size: 20px; }
  .v1-card-fields { display: grid; gap: 10px; margin-top: 18px; }
  .v1-card .cx-btn { width: 100%; margin-top: 16px; }

  .v1-strip { flex: none; display: flex; gap: 0; padding: 0 80px; border-bottom: 1px solid var(--cx-line); }
  .v1-cell { flex: 1 1 0; min-width: 0; display: flex; align-items: center; gap: 16px; height: 104px; padding-right: 28px; }
  .v1-cell + .v1-cell { padding-left: 28px; border-left: 1px solid var(--cx-line); }
  .v1-cell-ico { flex: none; width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--cx-tint); color: var(--cx-primary); font-size: 22px; }
  .v1-cell-label { color: var(--cx-muted); font-size: 14.5px; line-height: 1.3; }
  .v1-cell-value { font-size: 18.5px; font-weight: 600; line-height: 1.3; }
  .v1-cell-text { min-width: 0; }

  .v1-services { flex: 2 1 auto; min-height: 0; display: grid; grid-template-columns: 320px minmax(0, 1fr); align-content: center; column-gap: 72px; padding: 30px 80px; }
  .v1-h2 { font-size: 44px; font-weight: 700; line-height: 1.08; letter-spacing: -.026em; color: var(--cx-dark); }
  .v1-services-text { margin-top: 14px; color: var(--cx-body); font-size: 17.5px; }
  .v1-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr) auto; align-items: center; column-gap: 36px; min-height: 88px; padding: 14px 0; border-top: 1px solid var(--cx-line); }
  .v1-row:last-child { border-bottom: 1px solid var(--cx-line); }
  .v1-row-name { font-size: 24px; font-weight: 600; line-height: 1.22; letter-spacing: -.012em; }
  .v1-row-text { color: var(--cx-muted); font-size: 16px; line-height: 1.45; }
  .v1-row-more { color: var(--cx-primary); font-size: 16px; font-weight: 600; white-space: nowrap; }

  .v1-reviews { flex: 1 1 auto; min-height: 0; display: grid; grid-template-columns: 360px minmax(0, 1fr); align-content: center; align-items: center; column-gap: 72px; padding: 30px 80px; background: var(--cx-tint); }
  .v1-reviews-title { font-size: 32px; font-weight: 700; line-height: 1.12; letter-spacing: -.02em; color: var(--cx-dark); }
  .v1-score { display: flex; align-items: center; gap: 16px; margin-top: 16px; }
  .v1-score-num { color: var(--cx-dark); font-size: 54px; font-weight: 700; line-height: 1; letter-spacing: -.03em; }
  .v1-score .cx-stars { font-size: 24px; color: var(--cx-dark); }
  .v1-score-sub { margin-top: 5px; color: var(--cx-body); font-size: 15.5px; }
  .v1-quote-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; color: var(--cx-dark); }
  .v1-reviews .cx-quote { background: #fff; padding: 24px 26px; }

  .v1-form { flex: none; display: flex; align-items: center; gap: 48px; padding: 30px 80px; background: var(--cx-primary); color: #fff; }
  .v1-form-copy { flex: none; width: 320px; }
  .v1-form-title { font-size: 28px; font-weight: 700; line-height: 1.15; letter-spacing: -.018em; }
  .v1-form-text { margin-top: 4px; color: rgba(255, 255, 255, .92); font-size: 16px; line-height: 1.4; }
  .v1-form-fields { flex: 1 1 auto; min-width: 0; display: grid; grid-template-columns: 1fr 1fr 1.5fr auto; gap: 12px; }
  .v1-form .cx-field { box-shadow: none; height: 54px; }
  .v1-form .cx-btn { height: 54px; }

  .v1-foot { flex: none; min-height: 108px; display: flex; align-items: center; gap: 48px; padding: 18px 80px; border-top: 1px solid var(--cx-line); }
  .v1-form + .v1-foot { border-top: 0; }
  .v1-foot-chat { padding-right: 150px; }
  .v1-foot-brand { display: flex; align-items: center; gap: 14px; flex: 1 1 auto; min-width: 0; }
  .v1-foot-name { max-width: 460px; font-size: 19px; font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; }
  .v1-foot-contact { flex: 0 1 auto; min-width: 0; max-width: 380px; color: var(--cx-body); font-size: 15.5px; line-height: 1.45; }
  .v1-foot-contact b { color: var(--cx-ink); font-weight: 600; }
  .v1-foot-nav { flex: 0 1 auto; min-width: 0; display: flex; gap: 26px; color: var(--cx-body); font-size: 15.5px; font-weight: 500; }
  .v1-foot-nav > div { flex: 0 1 auto; min-width: 0; max-width: 170px; }
</style>
<div class="cx cx-v1" style="{{ ui.palette(cx) }}">
  {{ ui.tag(cx) }}

  <div class="v1-hero">
    {% if cx_photo %}
    <img class="v1-bg cx-photo" src="{{ cx_photo }}" alt="">
    {% else %}
    <svg class="v1-bg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <pattern id="v1-dots" width="28" height="28" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="2.2" fill="#fff" opacity=".3"/></pattern>
      </defs>
      <circle class="cx-f-primary" cx="1120" cy="430" r="400"/>
      <path class="cx-f-accent" d="M1440 0v230a230 230 0 0 1-230-230z"/>
      <circle class="cx-f-none cx-s-accent" cx="1120" cy="430" r="500" stroke-width="3"/>
      <circle class="cx-f-none cx-s-white" cx="1120" cy="430" r="600" stroke-width="1.5" opacity=".28"/>
      <circle class="cx-f-tint" cx="770" cy="760" r="120" opacity=".16"/>
      <rect x="560" y="150" width="280" height="196" fill="url(#v1-dots)"/>
      <path class="cx-f-dark" d="M920 900a260 260 0 0 1 520 0z" opacity=".55"/>
    </svg>
    {% endif %}
    <div class="v1-shade"></div>

    <div class="v1-top">
      <div class="v1-brand">
        {{ ui.mono(cx) }}
        {% if cx_name %}
        <div class="v1-name cx-one-line">{{ cx_name }}</div>
        {% endif %}
      </div>
      {% if cx_nav %}
      <div class="v1-nav">
        {% for n in cx_nav %}
        <div class="cx-one-line">{{ n }}</div>
        {% endfor %}
      </div>
      {% endif %}
      {% if cxf.tap_to_call %}
      <div class="v1-call{% if not cx_nav %} v1-top-end{% endif %}">{{ ui.icon('phone') }}<span class="cx-one-line">{{ cx_call }}</span></div>
      {% endif %}
    </div>

    <div class="v1-body{% if not card %} v1-body-solo{% endif %}">
      <div>
        {% if cx.category or cx.address %}
        <div class="v1-kicker">
          {% if cx.category %}
          <div class="v1-chip cx-one-line">{{ cx.category }}</div>
          {% endif %}
          {% if cx.address %}
          <div class="v1-where">{{ ui.icon('pin') }}<span class="cx-one-line">{{ cx.address }}</span></div>
          {% endif %}
        </div>
        {% endif %}
        <div class="v1-h1 v1-h1-{{ cx_hsize }} cx-clamp-3">{{ cx_headline }}</div>
        <div class="v1-sub{% if cx_sub_long %} v1-sub-long{% endif %} cx-clamp-3">{{ cx_sub }}</div>
        <div class="v1-actions">
          <div class="cx-btn cx-btn-white">{{ cx_cta }}</div>
          {% if cxf.tap_to_call %}
          <div class="cx-btn cx-btn-line">{{ ui.icon('phone') }}<span class="cx-one-line">{% if cx.phone %}Call {{ cx.phone }}{% else %}Call us{% endif %}</span></div>
          {% endif %}
        </div>
      </div>
      {% if card == 'booking' %}
      <div class="v1-card">
        <div class="v1-card-title">Book online</div>
        <div class="v1-card-text">Pick a day and a time that suits you.</div>
        <div class="v1-days">{{ ui.days(5, 3) }}</div>
        <div class="v1-slots">{{ ui.slots() }}</div>
        <div class="v1-chosen">{{ ui.icon('check') }}<span>Wednesday, around midday</span></div>
        <div class="cx-btn cx-btn-sm">Confirm booking</div>
      </div>
      {% elif card == 'enquiry' %}
      <div class="v1-card">
        <div class="v1-card-title">Send an enquiry</div>
        <div class="v1-card-text">Tell us what you need and we will get back to you.</div>
        <div class="v1-card-fields">
          <div class="cx-field">Your name</div>
          <div class="cx-field">Phone number</div>
          <div class="cx-field cx-field-tall">How can we help?</div>
        </div>
        <div class="cx-btn cx-btn-sm">Send enquiry</div>
      </div>
      {% endif %}
    </div>
  </div>

  {% if cx.address or cx.phone or cxf.booking or cxf.enquiry_form %}
  <div class="v1-strip">
    {% if cx.address %}
    <div class="v1-cell">
      <div class="v1-cell-ico">{{ ui.icon('pin') }}</div>
      <div class="v1-cell-text"><div class="v1-cell-label">Find us</div><div class="v1-cell-value cx-one-line">{{ cx.address }}</div></div>
    </div>
    {% endif %}
    {% if cx.phone %}
    <div class="v1-cell">
      <div class="v1-cell-ico">{{ ui.icon('phone') }}</div>
      <div class="v1-cell-text"><div class="v1-cell-label">Call us</div><div class="v1-cell-value cx-one-line">{{ cx.phone }}</div></div>
    </div>
    {% endif %}
    {% if cxf.booking or cxf.enquiry_form %}
    <div class="v1-cell">
      <div class="v1-cell-ico">{{ ui.icon('clock') }}</div>
      <div class="v1-cell-text"><div class="v1-cell-label">Online</div><div class="v1-cell-value cx-one-line">{{ 'Book at any hour' if cxf.booking else 'Message us at any hour' }}</div></div>
    </div>
    {% endif %}
  </div>
  {% endif %}

  {% if cx_services %}
  <div class="v1-services">
    <div>
      <div class="v1-h2">What we do</div>
      <div class="v1-services-text">{{ 'Find what you need, then book it in a couple of taps.' if cxf.booking else 'Find what you need, then get in touch.' }}</div>
    </div>
    <div>
      {% for s in cx_services %}
      <div class="v1-row">
        <div class="v1-row-name cx-clamp-2">{{ s }}</div>
        <div class="v1-row-text">{{ cx_lines[loop.index0] }}</div>
        <div class="v1-row-more">Find out more</div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if cxf.reviews %}
  <div class="v1-reviews">
    <div>
      <div class="v1-reviews-title">Your customer reviews</div>
      {% if cx_has_rating %}
      <div class="v1-score">
        <div class="v1-score-num">{{ '%.1f'|format(cx.rating) }}</div>
        <div>
          {{ ui.stars(cx.rating) }}
          <div class="v1-score-sub">{{ ui.review_count(cx) }}</div>
        </div>
      </div>
      {% endif %}
    </div>
    <div class="v1-quote-row">{{ ui.quote() }}{{ ui.quote() }}</div>
  </div>
  {% endif %}

  {% if form_band %}
  <div class="v1-form">
    <div class="v1-form-copy">
      <div class="v1-form-title">Send an enquiry</div>
      <div class="v1-form-text">We will get back to you.</div>
    </div>
    <div class="v1-form-fields">
      <div class="cx-field">Your name</div>
      <div class="cx-field">Phone number</div>
      <div class="cx-field">How can we help?</div>
      <div class="cx-btn cx-btn-white cx-btn-sm">Send enquiry</div>
    </div>
  </div>
  {% endif %}

  <div class="v1-foot{% if cxf.chat %} v1-foot-chat{% endif %}">
    <div class="v1-foot-brand">
      {{ ui.mono(cx) }}
      {% if cx_name %}
      <div class="v1-foot-name cx-clamp-2">{{ cx_name }}</div>
      {% endif %}
    </div>
    {% if cx.address or cx.phone %}
    <div class="v1-foot-contact">
      {% if cx.address %}
      <div class="cx-one-line">{{ cx.address }}</div>
      {% endif %}
      {% if cx.phone %}
      <div class="cx-one-line"><b>{{ cx.phone }}</b></div>
      {% endif %}
    </div>
    {% endif %}
    {% if cx_nav %}
    <div class="v1-foot-nav">
      {% for n in cx_nav %}
      <div class="cx-one-line">{{ n }}</div>
      {% endfor %}
    </div>
    {% endif %}
  </div>

  {{ ui.chat(cxf) }}
</div>
