{#
  Website review report. A4, printed to PDF by headless Chromium / Edge:
    --headless --no-pdf-header-footer --print-to-pdf=out.pdf report.html

  Self-contained: no external resources and no JavaScript. The only images are
  data: URIs handed in by the renderer (concept_image). Every value from the
  context is autoescaped; do not add |safe.

  What the document contains follows the data, so two businesses rarely get the
  same report:
    - site read, things to fix   cover, summary, "Where to start", staged plan,
                                 what already works, detail by area, what we would
                                 do, concept page, about
    - site read, nothing to fix  cover, summary, what already works (as the lead),
                                 one or two ideas, concept page, about
    - no site to read            cover, then the concept beside the introduction on
                                 page 1, where to start, what we would do, about
  Empty lists drop their section. theme.palette colours the document and
  theme.cover_variant (0-2) picks one of three first-page headers. The red / amber /
  green cues never take their colour from the theme.
#}
{% set site_read = summary.site_read is not false %}
{% set doc_kind = 'Website review' if site_read else 'Online presence review' %}
{% set tp = (theme.palette if theme else none) or (concept.palette if concept else none) or {} %}
{% set cover = theme.cover_variant|default(0, true)|int(0) if theme else 0 %}
{% if cover not in [0, 1, 2] %}{% set cover = 0 %}{% endif %}
{% set img = concept_image if (concept_image is string and concept_image.startswith('data:image/')) else '' %}
{% set initials = concept.initials if concept else '' %}
{% set counts = summary.counts or {} %}
{% set n_high = counts.high|default(0, true)|int %}
{% set n_medium = counts.medium|default(0, true)|int %}
{% set n_low = counts.low|default(0, true)|int %}
{% set n_passed = summary.checks_passed|default(0, true)|int %}
{% set prios = (priorities or [])[:3] %}
{% set prio_codes = prios|map(attribute='code')|list %}
{% set prio_titles = prios|map(attribute='title')|list %}
{% set stages = (plan or [])|selectattr('steps')|list %}
{% set good = strengths or [] %}
{% set problem_areas = (areas or [])|selectattr('findings')|list %}
{% set clear_areas = (areas or [])|rejectattr('findings')|list %}
{# Priority wording follows the findings' own severity_label when there is one. #}
{# detail: areas with something not yet set out under "Where to start"; covered: areas that are fully set out there. #}
{% set ns = namespace(total=0, steps=0, open=0, detail=[], covered=[], high='High priority', medium='Worth fixing', low='Nice to have') %}
{% for area in problem_areas %}
  {% set ns.open = 0 %}
  {% for f in area.findings %}
    {% set ns.total = ns.total + 1 %}
    {% if not ((f.code and f.code in prio_codes) or f.title in prio_titles) %}{% set ns.open = ns.open + 1 %}{% endif %}
    {% if f.severity_label %}
      {% if f.severity == 'high' %}{% set ns.high = f.severity_label %}
      {% elif f.severity == 'medium' %}{% set ns.medium = f.severity_label %}
      {% elif f.severity == 'low' %}{% set ns.low = f.severity_label %}
      {% endif %}
    {% endif %}
  {% endfor %}
  {% if ns.open %}{% set ns.detail = ns.detail + [area] %}{% else %}{% set ns.covered = ns.covered + [area] %}{% endif %}
{% endfor %}
{% for s in stages %}{% set ns.steps = ns.steps + s.steps|length + (s.more|default(0, true)|int) %}{% endfor %}
{# The plan and the detail only appear when they say more than "Where to start" already has. #}
{% set show_plan = stages and (ns.steps > prios|length or not prios) %}
{% set show_detail = ns.detail|length > 0 %}
{% set lead_concept = img and not site_read %}
{% set name_len = (lead.name or '')|length %}
{% set name_class = 'name-xlong' if name_len > 70 else ('name-long' if name_len > 34 else '') %}
{% set has_facts = site_read and (lead.website or summary.pages_checked or summary.response_seconds is number
                    or summary.https is boolean or summary.platform or summary.pagespeed_mobile is number or summary.checked_on) %}
{% set studio = sender.studio or sender.name %}

{% macro dots(sev) %}<span class="dots dots-{{ sev if sev in ['high', 'medium', 'low'] else 'low' }}" aria-hidden="true"><i></i><i></i><i></i></span>{% endmacro %}

{% macro tick() %}<svg class="tick" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.4 6.4l2.4 2.4 4.8-5.4"/></svg>{% endmacro %}

{% macro status(area) %}
{% if area.status_label %}
<p class="status status-{{ area.status if area.status in ['urgent', 'needs_work', 'minor', 'good'] else 'minor' }}">{% if area.status == 'good' %}{{ tick() }}{% else %}<span class="status-mark" aria-hidden="true"></span>{% endif %}<span>{{ area.status_label }}</span></p>
{% endif %}
{% endmacro %}

{% macro prio(f) %}
{% if f.severity_label %}
<p class="prio">{{ dots(f.severity) }}<span>{{ f.severity_label }}</span></p>
{% endif %}
{% endmacro %}

{% macro fix(f) %}
{% if f.fix %}
<div class="fix"><p class="fix-label">Recommended fix</p><p class="fix-text">{{ f.fix }}</p></div>
{% endif %}
{% endmacro %}

{# One finding in the detail section. Findings already set out under "Where to start" are a one-line pointer. #}
{% macro finding(f) %}
{% set at = (prio_codes.index(f.code) + 1) if (f.code and f.code in prio_codes) else ((prio_titles.index(f.title) + 1) if f.title in prio_titles else 0) %}
<div class="finding">
  <div class="finding-top">
    <h4 class="finding-title">{{ f.title }}</h4>
    {{ prio(f) }}
  </div>
  {% if at %}
  <p class="finding-see">Set out under &ldquo;Where to start&rdquo;, point {{ at }}.</p>
  {% else %}
  {% if f.what %}
  <p class="finding-what">{{ f.what }}</p>
  {% endif %}
  {{ fix(f) }}
  {% endif %}
</div>
{% endmacro %}

{% macro frame(caption) %}
<figure class="frame">
  <div class="frame-bar"><span class="frame-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="frame-addr">Concept preview</span></div>
  <img class="frame-img" src="{{ img }}" alt="Concept of a homepage for {{ lead.name }}">
</figure>
{% if caption and concept and concept.label %}
<p class="frame-label">{{ concept.label }}</p>
{% endif %}
{% endmacro %}

{% macro cover_where() %}
{% if lead.category or lead.address %}
<p class="cover-where">{% if lead.category %}<span>{{ lead.category }}</span>{% endif %}{% if lead.address %}<span>{{ lead.address }}</span>{% endif %}</p>
{% endif %}
{% endmacro %}

{% macro cover_by() %}
{% if sender.byline or studio %}
<p class="cover-by"><span>Prepared by</span> {{ sender.byline or studio }}</p>
{% endif %}
{% endmacro %}

{% macro plain_url(u) %}{{ (u|string|replace('https://', '')|replace('http://', '')).rstrip('/') }}{% endmacro %}
<!DOCTYPE html>
<html lang="en" style="{% if tp.primary %}--t-primary: {{ tp.primary }}; {% endif %}{% if tp.dark %}--t-dark: {{ tp.dark }}; {% endif %}{% if tp.tint %}--t-tint: {{ tp.tint }}; {% endif %}{% if tp.accent %}--t-accent: {{ tp.accent }};{% endif %}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ doc_kind }}{% if lead.name %}: {{ lead.name }}{% endif %}</title>
<style>
  @page {
    size: A4;
    /* Side margins live on .sheet so the cover can run to the paper's edge. */
    margin: 13mm 0 14mm 0;
    @bottom-left {
      content: "{{ doc_kind }}";
      padding: 0 0 4.5mm 16mm;
      font: 7.5pt "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
      color: #8388A0;
      vertical-align: bottom;
    }
    @bottom-right {
      content: "Page " counter(page) " of " counter(pages);
      padding: 0 16mm 4.5mm 0;
      font: 7.5pt "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
      color: #8388A0;
      vertical-align: bottom;
    }
  }
  @page :first { margin-top: 0; }

  :root {
    /* Theme: overridden from theme.palette on the html element. */
    --t-primary: #1D4ED8;
    --t-dark: #1E3A8A;
    --t-tint: #EFF6FF;
    --t-accent: #F59E0B;
    /* Fixed: reading colours and status cues do not follow the theme. */
    --ink: #1B1E2B;
    --text: #2C303D;
    --muted: #5F6473;
    --rule: #DADCE3;
    --red: #B5382C;
    --amber: #B36B00;
    --green: #2A7A4C;
    --slate: #6B7189;
    --sans: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
    --serif: Georgia, Cambria, "Times New Roman", "DejaVu Serif", serif;
  }

  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { margin: 0; background: #fff; color: var(--text); font-family: var(--sans); font-size: 9.2pt; line-height: 1.42; -webkit-text-size-adjust: 100%; }
  .doc, .doc *, .doc *::before, .doc *::after { box-sizing: border-box; }
  /* :where() keeps the reset at zero specificity, so single-class rules below still win */
  :where(.doc) :where(h1, h2, h3, h4, p, ul, ol, dl, dt, dd, figure) { margin: 0; padding: 0; font-size: inherit; font-weight: inherit; }
  :where(.doc) :where(ul, ol) { list-style: none; }
  :where(.doc) a { color: inherit; text-decoration: none; }

  .sheet { padding: 0 16mm; }

  /* ---------- Cover: three first-page headers ---------- */
  .cover { position: relative; break-inside: avoid; }
  .cover-kind { display: block; font-family: var(--sans); font-size: 11.5pt; font-weight: 600; line-height: 1.3; }
  .cover-name { display: block; max-width: 150mm; margin-top: 3mm; font-family: var(--serif); font-size: 29pt; font-weight: 400; line-height: 1.12; letter-spacing: -.012em; overflow-wrap: anywhere; text-wrap: balance; }
  .cover-name.name-long { font-size: 22pt; line-height: 1.16; }
  .cover-name.name-xlong { font-size: 17.5pt; line-height: 1.22; letter-spacing: 0; }
  .cover-where { display: flex; flex-wrap: wrap; gap: 0 3.2mm; margin-top: 3mm; font-size: 9.4pt; overflow-wrap: anywhere; }
  .cover-where span + span { padding-left: 3.2mm; border-left: 0.5pt solid currentColor; }
  .cover-by { font-size: 9.4pt; overflow-wrap: anywhere; }
  .cover-date { font-size: 9pt; line-height: 1.6; white-space: nowrap; }

  /* 0: full-width band in the brand colour */
  .cover-0 { padding: 10mm 16mm 5.5mm; border-bottom: 1.6mm solid var(--t-accent); background: var(--t-primary); color: #fff; }
  .cover-0 .cover-kind, .cover-0 .cover-date, .cover-0 .cover-by span { color: rgba(255, 255, 255, .84); }
  .cover-0 .cover-date { position: absolute; top: 10mm; right: 16mm; }
  .cover-0 .cover-where { color: rgba(255, 255, 255, .94); }
  .cover-0 .cover-by { margin-top: 4.5mm; padding-top: 2.2mm; border-top: 0.5pt solid rgba(255, 255, 255, .4); }

  /* 1: colour column at the left, title beside it on white */
  .cover-1 { display: grid; grid-template-columns: 58mm minmax(0, 1fr); min-height: 56mm; }
  .cover-1 .cover-side { display: flex; flex-direction: column; justify-content: space-between; padding: 11mm 6mm 6mm 16mm; background: var(--t-dark); color: #fff; }
  .cover-1 .cover-side::after { content: ""; width: 12mm; height: 1.6mm; background: var(--t-accent); }
  .cover-1 .cover-date { margin-top: 1.5mm; color: rgba(255, 255, 255, .86); white-space: normal; }
  .cover-1 .cover-main { display: flex; flex-direction: column; justify-content: flex-end; min-width: 0; padding: 11mm 16mm 5mm 5mm; border-bottom: 1.5pt solid var(--t-primary); color: var(--ink); }
  .cover-1 .cover-name { max-width: none; margin-top: 0; }
  .cover-1 .cover-where, .cover-1 .cover-by { color: var(--muted); }
  .cover-1 .cover-by { margin-top: 4mm; }
  .cover-1 .cover-by span { color: var(--t-primary); font-weight: 600; }

  /* 2: white cover with a large monogram block */
  .cover-2 { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 8mm; align-items: stretch; margin: 0 16mm; padding: 13mm 0 6mm; border-bottom: 1.5pt solid var(--t-primary); color: var(--ink); }
  .cover-2.cover-plain { grid-template-columns: minmax(0, 1fr); }
  .cover-mono { display: flex; align-items: center; justify-content: center; width: 36mm; min-height: 36mm; overflow: hidden; border-bottom: 1.8mm solid var(--t-accent); background: var(--t-primary); color: #fff; font-family: var(--serif); font-size: 30pt; line-height: 1; letter-spacing: .01em; white-space: nowrap; }
  .cover-mono-small { font-size: 19pt; }
  .cover-2 .cover-main { display: flex; flex-direction: column; min-width: 0; }
  .cover-2 .cover-line { display: flex; align-items: baseline; justify-content: space-between; gap: 6mm; }
  .cover-2 .cover-kind { color: var(--t-primary); }
  .cover-2 .cover-date, .cover-2 .cover-where { color: var(--muted); }
  .cover-2 .cover-name { max-width: none; margin-top: 2mm; }
  .cover-2 .cover-by { margin-top: auto; padding-top: 4mm; color: var(--muted); }
  .cover-2 .cover-by span { color: var(--t-primary); font-weight: 600; }

  /* ---------- Summary ---------- */
  .summary { padding-top: 6.5mm; break-inside: avoid; }
  .summary-grid { display: grid; grid-template-columns: minmax(0, 1fr) 58mm; column-gap: 10mm; align-items: start; }
  .summary-grid-1 { grid-template-columns: minmax(0, 1fr); }
  .lead { color: var(--ink); font-family: var(--serif); font-size: 17pt; line-height: 1.25; letter-spacing: -.005em; overflow-wrap: anywhere; text-wrap: balance; }
  .intro { max-width: 112mm; margin-top: 3mm; color: var(--text); font-size: 10pt; line-height: 1.5; overflow-wrap: anywhere; }
  .insight { padding: 0.5mm 0 1mm 4.5mm; border-left: 2pt solid var(--t-primary); break-inside: avoid; }
  .insight-label { color: var(--t-primary); font-size: 7.8pt; font-weight: 600; }
  .insight-text { margin-top: 1mm; color: var(--ink); font-family: var(--serif); font-size: 10pt; line-height: 1.42; overflow-wrap: anywhere; }
  .counts { display: flex; flex-wrap: wrap; gap: 3mm 0; margin-top: 5mm; }
  .count { padding: 0 7mm; border-left: 0.5pt solid var(--rule); }
  .count:first-child { padding-left: 0; border-left: 0; }
  .count-n { display: block; color: var(--ink); font-family: var(--serif); font-size: 19pt; line-height: 1.1; }
  .count-l { display: flex; align-items: center; gap: 1.4mm; margin-top: 0.8mm; color: var(--text); font-size: 8.2pt; font-weight: 600; white-space: nowrap; }
  .count-plain { align-self: flex-end; color: var(--text); font-size: 9.4pt; font-weight: 600; }
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 4mm; border-top: 0.5pt solid var(--rule); border-bottom: 0.5pt solid var(--rule); font-size: 8.6pt; }
  .fact { margin-bottom: -0.5pt; padding: 1.7mm 4mm 1.9mm 0; border-bottom: 0.5pt solid var(--rule); }
  .fact dt { color: var(--muted); font-size: 7.8pt; }
  .fact dd { color: var(--ink); font-weight: 600; overflow-wrap: anywhere; }

  /* No site to read: the concept leads, beside the introduction */
  .opening { display: grid; grid-template-columns: minmax(0, 1fr) 106mm; column-gap: 9mm; align-items: start; padding-top: 7mm; break-inside: avoid; }
  .opening .lead { font-size: 15.5pt; }
  .opening .intro { margin-top: 3.5mm; }
  .opening .insight { margin-top: 6mm; }
  .opening-note { margin-top: 6mm; color: var(--muted); font-size: 8.4pt; }

  /* ---------- Priority and status cues: a shape plus words; colour is only a helper ---------- */
  .dots { display: inline-flex; gap: 0.7mm; flex: none; }
  .dots i { width: 1.9mm; height: 1.9mm; border-radius: 50%; border: 0.6pt solid currentColor; }
  .dots-high { color: var(--red); }
  .dots-medium { color: var(--amber); }
  .dots-low { color: var(--slate); }
  .dots-high i, .dots-medium i:nth-child(-n+2), .dots-low i:first-child { background: currentColor; }
  .tick { flex: none; width: 2.9mm; height: 2.9mm; fill: none; stroke: var(--green); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .status { display: flex; align-items: center; gap: 1.5mm; margin-top: 1.3mm; color: var(--ink); font-size: 8pt; font-weight: 600; }
  .status-mark { flex: none; width: 2.3mm; height: 2.3mm; border-radius: 50%; border: 0.7pt solid currentColor; }
  .status-urgent .status-mark { color: var(--red); background: currentColor; }
  .status-needs_work .status-mark { color: var(--amber); background: linear-gradient(90deg, currentColor 50%, transparent 50%); }
  .status-minor .status-mark { color: var(--slate); }
  .prio { flex: none; display: flex; align-items: center; gap: 1.5mm; color: var(--text); font-size: 7.8pt; font-weight: 600; white-space: nowrap; }

  /* ---------- Sections ---------- */
  .sec { margin-top: 7mm; }
  .sec-head { break-inside: avoid; break-after: avoid; page-break-after: avoid; }
  .sec-title { padding-top: 3mm; border-top: 1.5pt solid var(--t-primary); color: var(--ink); font-family: var(--serif); font-size: 15.5pt; font-weight: 400; line-height: 1.2; letter-spacing: -.005em; break-after: avoid; page-break-after: avoid; }
  .sec-intro { margin-top: 1.4mm; color: var(--muted); font-size: 9pt; text-wrap: pretty; }

  .fix { display: grid; grid-template-columns: 26mm minmax(0, 1fr); column-gap: 2mm; align-items: baseline; margin-top: 1.3mm; padding: 0.9mm 2.4mm 1.1mm; border-radius: 1.2mm; background: var(--t-tint); }
  .fix-label { color: var(--t-primary); font-size: 7.8pt; font-weight: 600; white-space: nowrap; }
  .fix-text { color: var(--ink); overflow-wrap: anywhere; }

  /* ---------- Where to start: the loudest block in the document ---------- */
  /* Kept whole when it fits; if it cannot, it may split between points, never inside one. */
  .start { display: grid; grid-template-columns: 42mm minmax(0, 1fr); margin-top: 7mm; }
  .start-side { padding: 6mm 5mm 6mm 6mm; background: var(--t-primary); color: #fff; }
  .start-title { font-family: var(--serif); font-size: 18pt; line-height: 1.12; letter-spacing: -.008em; }
  .start-text { margin-top: 2.5mm; color: rgba(255, 255, 255, .94); font-size: 8.8pt; line-height: 1.45; }
  .start-list { padding: 1.5mm 6mm 2mm; background: var(--t-tint); }
  .start-item { display: grid; grid-template-columns: 10mm minmax(0, 1fr); padding: 3.5mm 0 3.7mm; break-inside: avoid; page-break-inside: avoid; }
  .start-item + .start-item { border-top: 0.5pt solid rgba(27, 30, 43, .16); }
  .start-n { color: var(--t-primary); font-family: var(--serif); font-size: 22pt; line-height: .95; }
  .start-top { display: flex; align-items: baseline; justify-content: space-between; gap: 5mm; }
  .start-name { min-width: 0; color: var(--ink); font-size: 11pt; font-weight: 600; line-height: 1.28; overflow-wrap: anywhere; }
  .start-area { margin-top: 0.3mm; color: var(--muted); font-size: 8pt; }
  .start-what { margin-top: 1.2mm; overflow-wrap: anywhere; }
  .start .fix { margin-top: 1.8mm; background: #fff; }
  .start-single .start-item { grid-template-columns: minmax(0, 1fr); }

  /* ---------- Plan: stages down a timeline ---------- */
  .plan-body { margin-top: 5mm; }
  .stage { position: relative; display: grid; grid-template-columns: 37mm minmax(0, 1fr); column-gap: 5mm; margin-left: 2.6mm; padding: 0 0 6mm 7.4mm; border-left: 1pt solid var(--t-primary); break-inside: avoid; page-break-inside: avoid; }
  .stage:last-child { padding-bottom: 1mm; }
  .stage-n { position: absolute; left: -2.9mm; top: -0.4mm; display: flex; align-items: center; justify-content: center; width: 5.6mm; height: 5.6mm; border-radius: 50%; background: var(--t-primary); color: #fff; font-size: 8.4pt; font-weight: 600; line-height: 1; box-shadow: 0 0 0 1mm #fff; }
  .stage-title { color: var(--ink); font-family: var(--serif); font-size: 11.5pt; font-weight: 700; line-height: 1.25; overflow-wrap: anywhere; }
  .stage-about { margin-top: 1.2mm; color: var(--muted); font-size: 8.2pt; line-height: 1.4; overflow-wrap: anywhere; }
  .steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3mm 7mm; }
  .steps-1 { grid-template-columns: minmax(0, 1fr); }
  .step { display: grid; grid-template-columns: 5mm minmax(0, 1fr); break-inside: avoid; }
  .step-box { width: 2.9mm; height: 2.9mm; margin-top: 1mm; border: 0.8pt solid var(--t-primary); border-radius: 0.6mm; }
  .step-action { color: var(--ink); overflow-wrap: anywhere; }
  .step-because { margin-top: 0.3mm; color: var(--muted); font-size: 8pt; overflow-wrap: anywhere; }
  .step-more { color: var(--muted); font-size: 8.6pt; padding-left: 5mm; align-self: center; }

  /* ---------- What is already working ---------- */
  .good-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.3mm 6mm; margin-top: 3.5mm; }
  .good-list li { display: flex; align-items: flex-start; gap: 1.8mm; min-width: 0; color: var(--ink); overflow-wrap: anywhere; }
  .good-list .tick { margin-top: 0.9mm; }
  .good-lead { padding: 4.5mm 6mm 4.5mm; border-top: 1.5pt solid var(--t-primary); background: var(--t-tint); break-inside: avoid; }
  .good-lead .sec-title { padding-top: 0; border-top: 0; }
  .good-lead .good-list { gap: 1.7mm 6mm; margin-top: 4mm; }
  .good-areas { margin-top: 4mm; padding-top: 2.6mm; border-top: 0.5pt solid rgba(27, 30, 43, .16); color: var(--muted); font-size: 8.6pt; }
  .good-areas b { color: var(--ink); font-weight: 600; }

  /* ---------- Detail, area by area ---------- */
  .area { margin-top: 2.7mm; padding-top: 2.5mm; border-top: 0.75pt solid var(--ink); }
  .sec-head + .area { margin-top: 3.2mm; }
  .area-first { display: grid; grid-template-columns: 42mm minmax(0, 1fr); column-gap: 5mm; align-items: start; break-inside: avoid; page-break-inside: avoid; }
  .area-rest { margin-left: 47mm; }
  .area-rest > * { margin-top: 2mm; padding-top: 2mm; border-top: 0.5pt solid var(--rule); }
  .area-title { color: var(--ink); font-family: var(--serif); font-size: 11pt; font-weight: 700; line-height: 1.25; overflow-wrap: anywhere; }
  .area-about { margin-top: 1.5mm; color: var(--muted); font-size: 8.2pt; line-height: 1.4; overflow-wrap: anywhere; }
  .finding { break-inside: avoid; page-break-inside: avoid; }
  .finding-top { display: flex; align-items: baseline; justify-content: space-between; gap: 5mm; }
  .finding-title { color: var(--ink); font-size: 9.8pt; font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; min-width: 0; }
  .finding-what { margin-top: 0.5mm; overflow-wrap: anywhere; }
  .finding-see { margin-top: 0.3mm; color: var(--muted); font-size: 8.6pt; }
  .clear { margin-top: 3.2mm; padding-top: 2.4mm; border-top: 0.75pt solid var(--ink); break-inside: avoid; break-before: avoid; page-break-before: avoid; }
  .clear p { display: grid; grid-template-columns: 47mm minmax(0, 1fr); color: var(--ink); font-size: 9pt; overflow-wrap: anywhere; }
  .clear p + p { margin-top: 1mm; }
  .clear-label { color: var(--muted); font-size: 8pt; font-weight: 600; line-height: 1.6; }
  .clear b { font-weight: 600; }

  /* ---------- What we would do ---------- */
  .recs-keep { break-inside: avoid; page-break-inside: avoid; }
  .rec-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 9mm; margin-top: 1.5mm; }
  .rec-grid-1 { grid-template-columns: minmax(0, 110mm); }
  .rec { padding: 2.5mm 0 2.7mm; border-bottom: 0.5pt solid var(--rule); break-inside: avoid; page-break-inside: avoid; }
  .rec-top { display: flex; align-items: baseline; justify-content: space-between; gap: 4mm; }
  .rec-title { color: var(--ink); font-size: 9.8pt; font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; min-width: 0; }
  .tag { flex: none; padding: 0.1mm 1.7mm 0.3mm; border: 0.5pt solid var(--t-primary); border-radius: 1mm; color: var(--t-primary); font-size: 7.4pt; font-weight: 600; white-space: nowrap; }
  .rec-detail { margin-top: 0.8mm; overflow-wrap: anywhere; }

  /* ---------- Homepage concept ---------- */
  .concept-page { margin-top: 0; break-before: page; page-break-before: always; break-after: page; page-break-after: always; break-inside: avoid; }
  .concept-page .frame { width: 163mm; margin-top: 5mm; }
  .frame { border: 1px solid #BFC3D0; border-radius: 2.2mm; overflow: hidden; background: #fff; break-inside: avoid; page-break-inside: avoid; }
  .frame-bar { display: flex; align-items: center; gap: 2.6mm; height: 6mm; padding: 0 2.6mm; border-bottom: 1px solid #BFC3D0; background: #ECEDF2; }
  .frame-dots { display: flex; gap: 1.1mm; flex: none; }
  .frame-dots i { width: 1.9mm; height: 1.9mm; border-radius: 50%; background: #C2C6D2; }
  .frame-addr { flex: 1 1 auto; min-width: 0; height: 3.8mm; padding: 0 2.6mm; border-radius: 1.9mm; background: #fff; color: var(--muted); font-size: 6.4pt; line-height: 3.8mm; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .frame-img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: top; }
  .frame-label { margin-top: 2.4mm; color: var(--ink); font-size: 8pt; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
  .shows { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6mm 4mm; margin-top: 1mm; color: var(--muted); font-size: 8pt; }
  .shows li { display: flex; align-items: center; gap: 1.3mm; white-space: nowrap; }
  .shows .tick { stroke: var(--t-primary); }

  /* ---------- About the sender ---------- */
  .concept-page + .about { margin-top: 0; }
  .about-grid { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: 10mm; align-items: start; margin-top: 4mm; }
  .about-grid-2 { grid-template-columns: minmax(0, 1fr) 72mm; }
  .about-lead { color: var(--ink); font-size: 10.2pt; overflow-wrap: anywhere; }
  .sub-title { color: var(--muted); font-size: 8pt; font-weight: 600; break-after: avoid; }
  .services { margin-top: 5mm; }
  .services ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 6mm; margin-top: 1.2mm; border-top: 0.5pt solid var(--rule); }
  .services li { padding: 1.5mm 0; border-bottom: 0.5pt solid var(--rule); color: var(--ink); font-weight: 600; overflow-wrap: anywhere; }
  .reply { padding: 5mm 5.5mm 5.5mm; border-radius: 1.6mm; background: var(--t-primary); color: #fff; break-inside: avoid; }
  .reply-title { font-family: var(--serif); font-size: 13pt; font-weight: 400; line-height: 1.25; }
  .reply-text { margin-top: 1.8mm; color: rgba(255, 255, 255, .94); font-size: 8.8pt; }
  .reply-ways { margin-top: 3.5mm; border-top: 0.5pt solid rgba(255, 255, 255, .4); }
  .reply-way { padding: 1.7mm 0 1.9mm; border-bottom: 0.5pt solid rgba(255, 255, 255, .4); }
  .reply-way dt { color: rgba(255, 255, 255, .86); font-size: 7.8pt; }
  .reply-way dd { font-size: 9.6pt; font-weight: 600; overflow-wrap: anywhere; }
  .work { margin-top: 8mm; break-inside: avoid; }
  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 9mm; margin-top: 1.2mm; border-top: 0.5pt solid var(--rule); }
  .work-item { padding: 2.8mm 0 3mm; border-bottom: 0.5pt solid var(--rule); break-inside: avoid; }
  .work-name { color: var(--ink); font-size: 9.8pt; font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; }
  .work-desc { margin-top: 0.6mm; overflow-wrap: anywhere; }
  .work-url { margin-top: 0.8mm; color: var(--t-primary); font-size: 8.4pt; overflow-wrap: anywhere; }
  .work-more { margin-top: 3mm; color: var(--muted); font-size: 8.8pt; overflow-wrap: anywhere; }
  .work-more a, .work-more span { color: var(--t-primary); font-weight: 600; }

  .method { margin-top: 10mm; padding-top: 2.6mm; border-top: 0.5pt solid var(--rule); color: var(--muted); font-size: 7.6pt; line-height: 1.5; break-inside: avoid; }
  .method p { max-width: 150mm; }

  @media screen {
    html { background: #E9EAF0; }
    body { width: 210mm; margin: 8mm auto; padding-bottom: 14mm; box-shadow: 0 2mm 8mm rgba(27, 30, 43, .16); }
    .concept-page { margin-top: 9mm; }
  }
</style>
</head>
<body>
<div class="doc">

  {% if cover == 1 %}
  <header class="cover cover-1">
    <div class="cover-side">
      <div>
        <p class="cover-kind">{{ doc_kind }}</p>
        {% if generated_on %}
        <p class="cover-date">{{ generated_on }}</p>
        {% endif %}
      </div>
    </div>
    <div class="cover-main">
      <h1 class="cover-name {{ name_class }}">{{ lead.name or doc_kind }}</h1>
      {{ cover_where() }}
      {{ cover_by() }}
    </div>
  </header>
  {% elif cover == 2 %}
  <header class="cover cover-2{% if not initials %} cover-plain{% endif %}">
    {% if initials %}
    <div class="cover-mono{% if initials|length > 2 %} cover-mono-small{% endif %}" aria-hidden="true">{{ initials }}</div>
    {% endif %}
    <div class="cover-main">
      <div class="cover-line">
        <p class="cover-kind">{{ doc_kind }}</p>
        {% if generated_on %}
        <p class="cover-date">{{ generated_on }}</p>
        {% endif %}
      </div>
      <h1 class="cover-name {{ name_class }}">{{ lead.name or doc_kind }}</h1>
      {{ cover_where() }}
      {{ cover_by() }}
    </div>
  </header>
  {% else %}
  <header class="cover cover-0">
    <p class="cover-kind">{{ doc_kind }}</p>
    {% if generated_on %}
    <p class="cover-date">{{ generated_on }}</p>
    {% endif %}
    <h1 class="cover-name {{ name_class }}">{{ lead.name or doc_kind }}</h1>
    {{ cover_where() }}
    {{ cover_by() }}
  </header>
  {% endif %}

  <div class="sheet">

    {% if lead_concept %}
    {# No site to read: the concept leads. #}
    <section class="opening">
      <div>
        {% if summary.headline %}
        <p class="lead">{{ summary.headline }}</p>
        {% endif %}
        {% if summary.intro %}
        <p class="intro">{{ summary.intro }}</p>
        {% endif %}
        {% if summary.insight %}
        <div class="insight">
          <p class="insight-label">Why it matters</p>
          <p class="insight-text">{{ summary.insight }}</p>
        </div>
        {% endif %}
        <p class="opening-note">The picture is a concept, not a finished design: it uses sample wording and simple shapes in place of your own text and photos.</p>
      </div>
      <div>
        {{ frame(true) }}
      </div>
    </section>
    {% else %}
    <section class="summary">
      <div class="summary-grid{% if not summary.insight %} summary-grid-1{% endif %}">
        <div>
          {% if summary.headline %}
          <p class="lead">{{ summary.headline }}</p>
          {% endif %}
          {% if summary.intro %}
          <p class="intro">{{ summary.intro }}</p>
          {% endif %}
        </div>
        {% if summary.insight %}
        <div class="insight">
          <p class="insight-label">Why it matters</p>
          <p class="insight-text">{{ summary.insight }}</p>
        </div>
        {% endif %}
      </div>
      {% if site_read and (n_high or n_medium or n_low or n_passed) %}
      <ul class="counts">
        {% if n_high %}
        <li class="count"><span class="count-n">{{ n_high }}</span><span class="count-l">{{ dots('high') }}{{ ns.high }}</span></li>
        {% endif %}
        {% if n_medium %}
        <li class="count"><span class="count-n">{{ n_medium }}</span><span class="count-l">{{ dots('medium') }}{{ ns.medium }}</span></li>
        {% endif %}
        {% if n_low %}
        <li class="count"><span class="count-n">{{ n_low }}</span><span class="count-l">{{ dots('low') }}{{ ns.low }}</span></li>
        {% endif %}
        {% if n_passed %}
        <li class="count"><span class="count-n">{{ n_passed }}</span><span class="count-l">{{ tick() }}{{ 'check passed' if n_passed == 1 else 'checks passed' }}</span></li>
        {% endif %}
        {% if n_passed and not (n_high or n_medium or n_low or ns.total) %}
        <li class="count count-plain">Nothing that needs fixing</li>
        {% endif %}
      </ul>
      {% endif %}
      {% if has_facts %}
      <dl class="facts">
        {% if lead.website %}
        <div class="fact"><dt>Website</dt><dd>{{ lead.website }}</dd></div>
        {% endif %}
        {% if summary.pages_checked %}
        <div class="fact"><dt>Pages checked</dt><dd>{{ summary.pages_checked }}</dd></div>
        {% endif %}
        {% if summary.response_seconds is number %}
        <div class="fact"><dt>Server response</dt><dd>{{ '%.1f'|format(summary.response_seconds) }} seconds</dd></div>
        {% endif %}
        {% if summary.https is boolean %}
        <div class="fact"><dt>Secure connection</dt><dd>{{ 'Yes' if summary.https else 'No' }}</dd></div>
        {% endif %}
        {% if summary.platform %}
        <div class="fact"><dt>Built with</dt><dd>{{ summary.platform }}</dd></div>
        {% endif %}
        {% if summary.pagespeed_mobile is number %}
        <div class="fact"><dt>Mobile speed score</dt><dd>{{ summary.pagespeed_mobile|round|int }} out of 100</dd></div>
        {% endif %}
        {% if summary.checked_on %}
        <div class="fact"><dt>Checked on</dt><dd>{{ summary.checked_on }}</dd></div>
        {% endif %}
      </dl>
      {% endif %}
    </section>
    {% endif %}

    {% if prios %}
    <section class="start{% if prios|length == 1 %} start-single{% endif %}">
      <div class="start-side">
        <h2 class="start-title">Where to start</h2>
        <p class="start-text">
          {% if prios|length == 1 %}
          The one change that would make the most difference.
          {% else %}
          The {{ ['', '', 'two', 'three'][prios|length] }} changes that would make the most difference, in the order we would take them.
          {% endif %}
        </p>
      </div>
      <ol class="start-list">
        {% for f in prios %}
        <li class="start-item">
          {% if prios|length > 1 %}
          <div class="start-n">{{ loop.index }}</div>
          {% endif %}
          <div>
            <div class="start-top">
              <h3 class="start-name">{{ f.title }}</h3>
              {{ prio(f) }}
            </div>
            {% if f.area %}
            <p class="start-area">{{ f.area }}</p>
            {% endif %}
            {% if f.what %}
            <p class="start-what">{{ f.what }}</p>
            {% endif %}
            {{ fix(f) }}
          </div>
        </li>
        {% endfor %}
      </ol>
    </section>
    {% endif %}

    {% if good and not ns.total and site_read %}
    {# Nothing to fix: what works is the lead of the report. #}
    <section class="sec good-lead">
      <h2 class="sec-title">What is already working</h2>
      <p class="sec-intro">{{ 'Every check came back fine.' if good|length > 1 else 'The check came back fine.' }}</p>
      <ul class="good-list">
        {% for item in good %}
        <li>{{ tick() }}<span>{{ item }}</span></li>
        {% endfor %}
      </ul>
      {% if clear_areas %}
      <p class="good-areas">Areas looked at: {% for a in clear_areas %}<b>{{ a.title }}</b>{{ ', ' if not loop.last else '.' }}{% endfor %}</p>
      {% endif %}
    </section>
    {% endif %}

    {% if show_plan %}
    <section class="sec plan">
      <div class="sec-head">
        <h2 class="sec-title">A plan, in stages</h2>
        <p class="sec-intro">{{ 'Start with what is quick, then build up. Each step can be ticked off on its own.' if stages|length > 1 else 'Each step can be ticked off on its own.' }}</p>
      </div>
      <div class="plan-body">
        {% for s in stages %}
        {% set more = s.more|default(0, true)|int %}
        <div class="stage">
          <div class="stage-n" aria-hidden="true">{{ loop.index }}</div>
          <div>
            <h3 class="stage-title">{{ s.title }}</h3>
            {% if s.about %}
            <p class="stage-about">{{ s.about }}</p>
            {% endif %}
          </div>
          <ul class="steps{% if s.steps|length + (1 if more else 0) == 1 %} steps-1{% endif %}">
            {% for step in s.steps %}
            <li class="step">
              <span class="step-box" aria-hidden="true"></span>
              <div>
                <p class="step-action">{{ step.action }}</p>
                {% if step.because %}
                <p class="step-because">Fixes: {{ step.because }}</p>
                {% endif %}
              </div>
            </li>
            {% endfor %}
            {% if more > 0 %}
            <li class="step-more">and {{ more }} more{{ ', set out in the detail below' if show_detail else '' }}</li>
            {% endif %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if good and ns.total and site_read %}
    <section class="sec good">
      <div class="sec-head">
        <h2 class="sec-title">What is already working</h2>
      </div>
      <ul class="good-list">
        {% for item in good %}
        <li>{{ tick() }}<span>{{ item }}</span></li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {% if show_detail %}
    <section class="sec detail">
      <div class="sec-head">
        <h2 class="sec-title">The detail, area by area</h2>
        <p class="sec-intro">For each point: what we saw, why it matters and what we would change.</p>
      </div>
      {% for area in ns.detail %}
      <div class="area">
        <div class="area-first">
          <div>
            <h3 class="area-title">{{ area.title }}</h3>
            {{ status(area) }}
            {% if area.about %}
            <p class="area-about">{{ area.about }}</p>
            {% endif %}
          </div>
          {{ finding(area.findings[0]) }}
        </div>
        {% if area.findings|length > 1 %}
        <div class="area-rest">
          {% for f in area.findings[1:] %}
          {{ finding(f) }}
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endfor %}
      {% if ns.covered or clear_areas %}
      <div class="clear">
        {% if ns.covered %}
        <p><span class="clear-label">Set out under &ldquo;Where to start&rdquo;</span><span>{% for a in ns.covered %}<b>{{ a.title }}</b>{{ ', ' if not loop.last }}{% endfor %}</span></p>
        {% endif %}
        {% if clear_areas %}
        <p><span class="clear-label">Nothing to fix in</span><span>{% for a in clear_areas %}<b>{{ a.title }}</b>{{ ', ' if not loop.last }}{% endfor %}</span></p>
        {% endif %}
      </div>
      {% endif %}
    </section>
    {% endif %}

    {% if recommendations %}
    <section class="sec recs{% if recommendations|length <= 8 %} recs-keep{% endif %}">
      <div class="sec-head">
        <h2 class="sec-title">What we would do</h2>
        <p class="sec-intro">{{ 'The work we would suggest, based on the points above.' if (ns.total or prios) else ('One idea, if it is useful.' if recommendations|length == 1 else 'A few ideas, if they are useful.') }}</p>
      </div>
      <div class="rec-grid{% if recommendations|length == 1 %} rec-grid-1{% endif %}">
        {% for r in recommendations %}
        <div class="rec">
          <div class="rec-top">
            <h3 class="rec-title">{{ r.title }}</h3>
            {% if r.service_label %}
            <span class="tag">{{ r.service_label }}</span>
            {% endif %}
          </div>
          {% if r.detail %}
          <p class="rec-detail">{{ r.detail }}</p>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {% if img and not lead_concept %}
    {% set cf = (concept.features if concept else none) or {} %}
    <section class="sec concept-page">
      <div class="sec-head">
        <h2 class="sec-title">How your homepage could look</h2>
        <p class="sec-intro">
          {% if concept and concept.uses_own_words %}
          This is a concept, not a finished design: your own headline and wording, set in a sample layout.
          {% else %}
          This is a concept, not a finished design: it uses sample wording and simple shapes in place of your own text and photos.
          {% endif %}
        </p>
      </div>
      {{ frame(true) }}
      {% if cf.booking or cf.enquiry_form or cf.tap_to_call or cf.chat or cf.reviews %}
      <ul class="shows">
        <li>It shows</li>
        {% if cf.booking %}<li>{{ tick() }}<span>Online booking</span></li>{% endif %}
        {% if cf.enquiry_form %}<li>{{ tick() }}<span>Enquiry form</span></li>{% endif %}
        {% if cf.tap_to_call %}<li>{{ tick() }}<span>Tap-to-call</span></li>{% endif %}
        {% if cf.chat %}<li>{{ tick() }}<span>Chat</span></li>{% endif %}
        {% if cf.reviews %}<li>{{ tick() }}<span>Your reviews</span></li>{% endif %}
      </ul>
      {% endif %}
    </section>
    {% endif %}

    {% set work = (sender.portfolio or [])[:4] %}
    {% set wa_digits = (sender.whatsapp or '')|string|replace('+', '')|replace(' ', '')|replace('-', '')|replace('(', '')|replace(')', '') %}
    {% set can_reply = sender.email or sender.whatsapp %}
    {% if studio or sender.services or work or can_reply %}
    <section class="sec about">
      <div class="sec-head">
        <h2 class="sec-title">{% if studio %}About {{ studio }}{% else %}Who prepared this{% endif %}</h2>
      </div>
      <div class="about-grid{% if can_reply %} about-grid-2{% endif %}">
        <div>
          {% if sender.name and sender.studio %}
          <p class="about-lead">This review was prepared by {{ sender.name }} of {{ sender.studio }}.</p>
          {% elif studio %}
          <p class="about-lead">This review was prepared by {{ studio }}.</p>
          {% endif %}
          {% if sender.services %}
          <div class="services">
            <h3 class="sub-title">What we do</h3>
            <ul>
              {% for s in sender.services %}
              <li>{{ s }}</li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}
        </div>
        {% if can_reply %}
        <div class="reply">
          <h3 class="reply-title">If any of this is useful</h3>
          <p class="reply-text">You did not ask for this review, so there is nothing you need to do with it. If you would like to talk a point through, a short reply is enough.</p>
          <dl class="reply-ways">
            {% if sender.email %}
            <div class="reply-way"><dt>Email</dt><dd><a href="mailto:{{ sender.email }}">{{ sender.email }}</a></dd></div>
            {% endif %}
            {% if sender.whatsapp %}
            <div class="reply-way"><dt>WhatsApp</dt><dd>{% if wa_digits.isdigit() %}<a href="https://wa.me/{{ wa_digits }}">{{ sender.whatsapp }}</a>{% else %}{{ sender.whatsapp }}{% endif %}</dd></div>
            {% endif %}
          </dl>
        </div>
        {% endif %}
      </div>
      {% if work or sender.portfolio_url %}
      <div class="work">
        {% if work %}
        <h3 class="sub-title">Recent work</h3>
        <div class="work-grid">
          {% for w in work %}
          <div class="work-item">
            {% if w.name %}
            <p class="work-name">{{ w.name }}</p>
            {% endif %}
            {% if w.description %}
            <p class="work-desc">{{ w.description }}</p>
            {% endif %}
            {% if w.url %}
            <p class="work-url">{% if w.url.startswith(('http://', 'https://')) %}<a href="{{ w.url }}">{{ plain_url(w.url) }}</a>{% else %}{{ w.url }}{% endif %}</p>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% endif %}
        {% if sender.portfolio_url %}
        <p class="work-more">{{ 'More work at' if work else 'Our work is at' }} {% if sender.portfolio_url.startswith(('http://', 'https://')) %}<a href="{{ sender.portfolio_url }}">{{ plain_url(sender.portfolio_url) }}</a>{% else %}<span>{{ sender.portfolio_url }}</span>{% endif %}</p>
        {% endif %}
      </div>
      {% endif %}
    </section>
    {% endif %}

    {% if method_note %}
    <footer class="method">
      <p>{{ method_note }}</p>
    </footer>
    {% endif %}

  </div>
</div>
</body>
</html>
