{#
  Concept layout 3: centred hero on the brand colour (over the photo when there
  is one) under a floating white header; an enquiry bar that overlaps the bottom
  of the hero; services as a tab strip with one panel open; reviews as cards on
  the tint; booking as a calendar beside a dark panel; centred footer.
#}
{% import "_concept_ui.html.j2" as ui %}
{% set bar = 'enquiry' if cxf.enquiry_form else ('booking' if cxf.booking else ('contact' if (cx.phone or cx.address) else '')) %}
{% set book_band = cxf.booking and cxf.enquiry_form %}
<style>
  .cx-v3 .cx-tag { top: 128px; }
  .cx-v3 .cx-chat { flex-direction: row; align-items: center; }

  .v3-hero { position: relative; flex: 3 1 auto; min-height: 0; display: flex; flex-direction: column; overflow: hidden; background: var(--cx-primary); color: #fff; }
  .v3-hero-bar { padding-bottom: 92px; }
  .v3-bg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .v3-shade { position: absolute; inset: 0; background: radial-gradient(ellipse 62% 70% at 50% 56%, color-mix(in srgb, var(--cx-dark) 84%, transparent) 0%, color-mix(in srgb, var(--cx-dark) 66%, transparent) 55%, color-mix(in srgb, var(--cx-dark) 30%, transparent) 100%); }

  .v3-top { position: relative; flex: none; display: flex; align-items: center; gap: 30px; height: 72px; margin: 28px 48px 0; padding: 0 13px; border-radius: 20px; background: #fff; color: var(--cx-ink); box-shadow: 0 20px 44px -22px rgba(0, 0, 0, .55); }
  .v3-brand { display: flex; align-items: center; gap: 13px; min-width: 260px; flex: 0 1 auto; }
  .v3-name { max-width: 400px; font-size: 20px; font-weight: 600; letter-spacing: -.01em; }
  .v3-nav { flex: 0 1 auto; min-width: 0; display: flex; align-items: center; gap: 34px; margin: 0 auto; }
  .v3-nav > div { flex: 0 1 auto; min-width: 0; max-width: 180px; color: #3B4150; font-size: 16px; font-weight: 500; }
  .v3-call { flex: none; display: flex; align-items: center; gap: 10px; max-width: 270px; height: 46px; margin-left: auto; padding: 0 20px; border-radius: 12px; background: var(--cx-primary); color: #fff; font-size: 16px; font-weight: 600; }
  .v3-nav + .v3-call { margin-left: 0; }

  .v3-center { position: relative; flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 28px 120px 34px; text-align: center; }
  .v3-kicker { display: flex; align-items: center; justify-content: center; gap: 16px; max-width: 900px; margin-bottom: 20px; }
  .v3-chip { flex: none; max-width: 320px; padding: 6px 15px 7px; border-radius: 999px; background: rgba(255, 255, 255, .16); box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, .6); font-size: 15px; font-weight: 600; }
  .v3-where { display: flex; align-items: center; gap: 7px; min-width: 0; color: rgba(255, 255, 255, .92); font-size: 15.5px; }
  .v3-h1 { max-width: 1060px; padding-bottom: 6px; font-weight: 700; }
  .v3-h1-xl { font-size: 78px; line-height: 1.04; letter-spacing: -.03em; }
  .v3-h1-l { font-size: 64px; line-height: 1.06; letter-spacing: -.026em; }
  .v3-h1-m { font-size: 52px; line-height: 1.1; letter-spacing: -.02em; }
  .v3-sub { max-width: 780px; margin-top: 18px; color: rgba(255, 255, 255, .94); font-size: 21px; line-height: 1.5; }
  .v3-sub-long { font-size: 18.5px; }
  .v3-actions { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 28px; }
  .v3-actions .cx-btn-line { max-width: 380px; }

  .v3-float { position: relative; z-index: 3; flex: none; display: grid; align-items: center; gap: 12px; margin: -66px 120px 0; padding: 22px 24px 22px 28px; border-radius: 24px; background: #fff; box-shadow: 0 30px 60px -30px rgba(20, 24, 40, .5), 0 0 0 1px rgba(20, 24, 40, .06); }
  .v3-float-enquiry { grid-template-columns: 216px 1fr 1fr 1.5fr auto; }
  .v3-float-booking { grid-template-columns: 200px 2.2fr 1.6fr auto; column-gap: 20px; }
  .v3-float-contact { grid-template-columns: 200px 1fr 1.4fr auto; column-gap: 24px; }
  .v3-float-title { font-size: 22px; font-weight: 700; line-height: 1.2; letter-spacing: -.012em; }
  .v3-float-text { margin-top: 2px; color: var(--cx-muted); font-size: 15px; line-height: 1.35; }
  .v3-float .cx-field, .v3-float .cx-btn { height: 54px; }
  .v3-float-days { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .v3-float-slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .v3-float-item { display: flex; align-items: center; gap: 12px; min-width: 0; font-size: 18px; font-weight: 600; }
  .v3-float-item .cx-ico { color: var(--cx-primary); font-size: 21px; }

  .v3-services { flex: 2 1 auto; min-height: 0; display: flex; flex-direction: column; justify-content: center; padding: 30px 120px 26px; }
  .v3-h2 { color: var(--cx-dark); font-size: 36px; font-weight: 700; line-height: 1.12; letter-spacing: -.022em; }
  .v3-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 16px; }
  .v3-tabs-1 { grid-template-columns: minmax(0, 400px); }
  .v3-tabs-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .v3-tab { padding: 12px 20px 13px 0; border-bottom: 3px solid var(--cx-line); color: var(--cx-muted); font-size: 18px; font-weight: 600; }
  .v3-tab-on { border-bottom-color: var(--cx-primary); color: var(--cx-dark); }
  .v3-panel { display: grid; grid-template-columns: minmax(0, 1fr) 440px; align-items: center; column-gap: 64px; margin-top: 24px; }
  .v3-panel-name { font-size: 29px; font-weight: 700; line-height: 1.18; letter-spacing: -.018em; }
  .v3-panel-text { max-width: 560px; margin-top: 8px; color: var(--cx-body); font-size: 17px; }
  .v3-points { display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 16px; }
  .v3-point { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 600; white-space: nowrap; }
  .v3-point-mark { flex: none; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--cx-tint); color: var(--cx-primary); font-size: 15px; box-shadow: inset 0 0 0 1px var(--cx-line); }
  .v3-panel-more { margin-top: 16px; color: var(--cx-primary); font-size: 16px; font-weight: 600; }
  .v3-tile { width: 440px; height: 190px; border-radius: 24px; overflow: hidden; background: var(--cx-tint); }
  .v3-tile svg { width: 440px; height: 190px; }

  .v3-reviews { flex: none; padding: 28px 120px 30px; background: var(--cx-tint); }
  .v3-reviews-head { display: flex; align-items: center; justify-content: space-between; gap: 40px; }
  .v3-reviews-title { color: var(--cx-dark); font-size: 30px; font-weight: 700; line-height: 1.15; letter-spacing: -.02em; }
  .v3-score { display: flex; align-items: center; gap: 14px; color: var(--cx-dark); }
  .v3-score-num { font-size: 30px; font-weight: 700; line-height: 1; letter-spacing: -.02em; }
  .v3-score .cx-stars { font-size: 23px; }
  .v3-score-sub { color: var(--cx-body); font-size: 15.5px; white-space: nowrap; }
  .v3-quote-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-top: 16px; color: var(--cx-dark); }
  .v3-reviews .cx-quote { padding: 18px 22px; border-style: solid; border-color: var(--cx-line); border-width: 1px; background: #fff; }
  .v3-reviews .cx-quote-who { margin-top: 14px; }

  .v3-book { flex: 1 1 auto; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); }
  .v3-book-copy { display: flex; flex-direction: column; justify-content: center; padding: 26px 56px 26px 120px; background: var(--cx-dark); color: #fff; }
  .v3-book-title { font-size: 38px; font-weight: 700; line-height: 1.1; letter-spacing: -.024em; }
  .v3-book-text { max-width: 380px; margin-top: 10px; color: rgba(255, 255, 255, .92); font-size: 17px; }
  .v3-book-chosen { align-self: flex-start; display: flex; align-items: center; gap: 10px; height: 44px; margin-top: 18px; padding: 0 16px; border-radius: 12px; background: rgba(255, 255, 255, .12); box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, .45); font-size: 15.5px; font-weight: 600; }
  .v3-book-main { display: grid; grid-template-columns: minmax(0, 1fr) 200px; align-content: center; align-items: start; column-gap: 28px; padding: 26px 120px 26px 48px; }
  .v3-cal { display: grid; grid-template-columns: repeat(7, 1fr); gap: 7px; }
  .v3-cal-head { height: 22px; color: var(--cx-muted); font-size: 13.5px; font-weight: 600; text-align: center; }
  .v3-day { display: flex; align-items: center; justify-content: center; height: 42px; border-radius: 11px; box-shadow: inset 0 0 0 1.5px var(--cx-line); color: #3B4150; font-size: 15.5px; font-weight: 600; }
  .v3-day-off { box-shadow: none; background: #F3F4F6; color: #A3A8B3; }
  .v3-day-on { box-shadow: none; background: var(--cx-primary); color: #fff; }
  .v3-times { display: grid; gap: 7px; padding-top: 29px; }
  .v3-times .cx-pick { height: 42px; }
  .v3-times .cx-btn { height: 42px; margin-top: 0; padding: 0 14px; font-size: 15.5px; border-radius: 11px; }

  .v3-foot { flex: none; display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 22px 300px 22px; background: var(--cx-primary); color: #fff; text-align: center; }
  .v3-foot-brand { display: flex; align-items: center; justify-content: center; gap: 13px; max-width: 100%; }
  .v3-foot .cx-mono { background: #fff; color: var(--cx-dark); }
  .v3-foot-name { min-width: 0; font-size: 19px; font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; text-align: left; }
  .v3-foot-row { display: flex; align-items: center; justify-content: center; gap: 28px; max-width: 100%; color: rgba(255, 255, 255, .94); font-size: 15px; font-weight: 500; }
  .v3-foot-row > div { flex: 0 1 auto; min-width: 0; max-width: 300px; }
  .v3-foot-row b { font-weight: 600; color: #fff; }
</style>
<div class="cx cx-v3" style="{{ ui.palette(cx) }}">
  {{ ui.tag(cx) }}

  <div class="v3-hero{% if bar %} v3-hero-bar{% endif %}">
    {% if cx_photo %}
    <img class="v3-bg cx-photo" src="{{ cx_photo }}" alt="">
    <div class="v3-shade"></div>
    {% else %}
    <svg class="v3-bg" viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path class="cx-f-dark" d="M0 760V380a380 380 0 0 1 380 380z" opacity=".55"/>
      <path class="cx-f-dark" d="M1440 0v300a300 300 0 0 1-300-300z" opacity=".5"/>
      <circle class="cx-f-none cx-s-white" cx="720" cy="430" r="330" stroke-width="1.5" opacity=".22"/>
      <circle class="cx-f-none cx-s-white" cx="720" cy="430" r="470" stroke-width="1.5" opacity=".16"/>
      <circle class="cx-f-none cx-s-white" cx="720" cy="430" r="620" stroke-width="1.5" opacity=".11"/>
      <circle class="cx-f-accent" cx="1236" cy="520" r="54"/>
      <circle class="cx-f-accent" cx="150" cy="232" r="22"/>
      <rect class="cx-f-white" x="1150" y="610" width="230" height="10" rx="5" opacity=".2"/>
      <rect class="cx-f-white" x="1210" y="636" width="170" height="10" rx="5" opacity=".14"/>
    </svg>
    {% endif %}

    <div class="v3-top">
      <div class="v3-brand">
        {{ ui.mono(cx) }}
        {% if cx_name %}
        <div class="v3-name cx-one-line">{{ cx_name }}</div>
        {% endif %}
      </div>
      {% if cx_nav %}
      <div class="v3-nav">
        {% for n in cx_nav %}
        <div class="cx-one-line">{{ n }}</div>
        {% endfor %}
      </div>
      {% endif %}
      {% if cxf.tap_to_call %}
      <div class="v3-call">{{ ui.icon('phone') }}<span class="cx-one-line">{{ cx_call }}</span></div>
      {% endif %}
    </div>

    <div class="v3-center">
      {% if cx.category or cx.address %}
      <div class="v3-kicker">
        {% if cx.category %}
        <div class="v3-chip cx-one-line">{{ cx.category }}</div>
        {% endif %}
        {% if cx.address %}
        <div class="v3-where">{{ ui.icon('pin') }}<span class="cx-one-line">{{ cx.address }}</span></div>
        {% endif %}
      </div>
      {% endif %}
      <div class="v3-h1 v3-h1-{{ cx_hsize }} cx-clamp-3">{{ cx_headline }}</div>
      <div class="v3-sub{% if cx_sub_long %} v3-sub-long{% endif %} cx-clamp-3">{{ cx_sub }}</div>
      <div class="v3-actions">
        <div class="cx-btn cx-btn-white">{{ cx_cta }}</div>
        {% if cxf.tap_to_call %}
        <div class="cx-btn cx-btn-line">{{ ui.icon('phone') }}<span class="cx-one-line">{% if cx.phone %}Call {{ cx.phone }}{% else %}Call us{% endif %}</span></div>
        {% endif %}
      </div>
    </div>
  </div>

  {% if bar == 'enquiry' %}
  <div class="v3-float v3-float-enquiry">
    <div>
      <div class="v3-float-title">Send an enquiry</div>
      <div class="v3-float-text">We will get back to you.</div>
    </div>
    <div class="cx-field">Your name</div>
    <div class="cx-field">Phone number</div>
    <div class="cx-field">How can we help?</div>
    <div class="cx-btn cx-btn-sm">Send enquiry</div>
  </div>
  {% elif bar == 'booking' %}
  <div class="v3-float v3-float-booking">
    <div>
      <div class="v3-float-title">Book online</div>
      <div class="v3-float-text">Pick a day and a time.</div>
    </div>
    <div class="v3-float-days">{{ ui.days(5, 3) }}</div>
    <div class="v3-float-slots">{{ ui.slots() }}</div>
    <div class="cx-btn cx-btn-sm">Confirm booking</div>
  </div>
  {% elif bar == 'contact' %}
  <div class="v3-float v3-float-contact">
    <div>
      <div class="v3-float-title">Get in touch</div>
      <div class="v3-float-text">We are glad to help.</div>
    </div>
    <div class="v3-float-item">{% if cx.phone %}{{ ui.icon('phone') }}<span class="cx-one-line">{{ cx.phone }}</span>{% endif %}</div>
    <div class="v3-float-item">{% if cx.address %}{{ ui.icon('pin') }}<span class="cx-one-line">{{ cx.address }}</span>{% endif %}</div>
    <div class="cx-btn cx-btn-sm">Get in touch</div>
  </div>
  {% endif %}

  {% if cx_services %}
  <div class="v3-services">
    <div class="v3-h2">What we do</div>
    <div class="v3-tabs v3-tabs-{{ cx_services|length }}">
      {% for s in cx_services %}
      <div class="v3-tab{% if loop.first %} v3-tab-on{% endif %} cx-one-line">{{ s }}</div>
      {% endfor %}
    </div>
    <div class="v3-panel">
      <div>
        <div class="v3-panel-name cx-clamp-2">{{ cx_services[0] }}</div>
        <div class="v3-panel-text">{{ cx_lines[0] }}</div>
        <div class="v3-points">
          {% for p in ['What is included', 'Who it is for', 'How to book' if cxf.booking else 'How to arrange it'] %}
          <div class="v3-point"><div class="v3-point-mark">{{ ui.icon('check') }}</div>{{ p }}</div>
          {% endfor %}
        </div>
        <div class="v3-panel-more">Find out more</div>
      </div>
      <div class="v3-tile">
        <svg viewBox="0 0 440 190" aria-hidden="true">
          <rect class="cx-f-tint" width="440" height="190"/>
          <path class="cx-f-primary" d="M0 190V60a130 130 0 0 1 130 130z"/>
          <circle class="cx-f-accent" cx="212" cy="82" r="44"/>
          <path class="cx-f-dark" d="M440 0v190h-150a150 150 0 0 1 150-190z"/>
          <circle class="cx-f-none cx-s-primary" cx="212" cy="82" r="68" stroke-width="2"/>
          <rect class="cx-f-primary" x="150" y="160" width="124" height="8" rx="4" opacity=".35"/>
        </svg>
      </div>
    </div>
  </div>
  {% endif %}

  {% if cxf.reviews %}
  <div class="v3-reviews">
    <div class="v3-reviews-head">
      <div class="v3-reviews-title">Your customer reviews</div>
      {% if cx_has_rating %}
      <div class="v3-score">
        <div class="v3-score-num">{{ '%.1f'|format(cx.rating) }}</div>
        {{ ui.stars(cx.rating) }}
        <div class="v3-score-sub">{{ ui.review_count(cx) }}</div>
      </div>
      {% endif %}
    </div>
    <div class="v3-quote-row">{{ ui.quote() }}{{ ui.quote() }}{{ ui.quote() }}</div>
  </div>
  {% endif %}

  {% if book_band %}
  <div class="v3-book">
    <div class="v3-book-copy">
      <div class="v3-book-title">Book online</div>
      <div class="v3-book-text">Pick a day and a time that suits you. A reminder goes out before the visit.</div>
      <div class="v3-book-chosen">{{ ui.icon('check') }}<span>Wednesday, around midday</span></div>
    </div>
    <div class="v3-book-main">
      <div class="v3-cal">
        {% for d in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] %}
        <div class="v3-cal-head">{{ d }}</div>
        {% endfor %}
        {% for n in range(1, 22) %}
        <div class="v3-day{% if n == 10 %} v3-day-on{% elif n in [1, 2, 7, 14, 21] %} v3-day-off{% endif %}">{{ n }}</div>
        {% endfor %}
      </div>
      <div class="v3-times">
        {{ ui.slots() }}
        <div class="cx-btn">Confirm booking</div>
      </div>
    </div>
  </div>
  {% endif %}

  <div class="v3-foot">
    <div class="v3-foot-brand">
      {{ ui.mono(cx) }}
      {% if cx_name %}
      <div class="v3-foot-name cx-clamp-2">{{ cx_name }}</div>
      {% endif %}
    </div>
    {% if cx_nav or cx.address or cx.phone %}
    <div class="v3-foot-row">
      {% for n in cx_nav[:3] %}
      <div class="cx-one-line">{{ n }}</div>
      {% endfor %}
      {% if cx.address %}
      <div class="cx-one-line">{{ cx.address }}</div>
      {% endif %}
      {% if cx.phone %}
      <div class="cx-one-line"><b>{{ cx.phone }}</b></div>
      {% endif %}
    </div>
    {% endif %}
  </div>

  {{ ui.chat(cxf) }}
</div>
