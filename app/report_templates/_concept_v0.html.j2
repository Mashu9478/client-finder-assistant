{#
  Concept layout 0: split hero with a picture panel, three service cards,
  a dark reviews band, booking and enquiry panels side by side, dark footer bar.
  The picture panel is the business's own photo when there is one, otherwise a
  shopfront drawn in the palette.
#}
{% import "_concept_ui.html.j2" as ui %}
{% set two_panels = cxf.booking and cxf.enquiry_form %}
<style>
  .v0-top { flex: none; height: 84px; display: flex; align-items: center; gap: 36px; padding: 0 72px; border-bottom: 1px solid var(--cx-line); }
  .v0-brand { display: flex; align-items: center; gap: 14px; min-width: 0; flex: 0 1 auto; }
  .v0-top .v0-brand { min-width: 280px; }
  .v0-name { max-width: 430px; font-size: 21px; font-weight: 600; letter-spacing: -.01em; }
  .v0-nav { flex: 0 1 auto; min-width: 0; display: flex; align-items: center; gap: 30px; margin-left: auto; }
  .v0-nav > div { flex: 0 1 auto; min-width: 0; max-width: 190px; font-size: 16px; font-weight: 500; color: #3B4150; }
  .v0-call { flex: none; display: flex; align-items: center; gap: 10px; max-width: 270px; height: 46px; padding: 0 20px; border-radius: 999px; box-shadow: inset 0 0 0 1.5px var(--cx-primary); color: var(--cx-dark); font-size: 16px; font-weight: 600; }
  .v0-call .cx-ico { color: var(--cx-primary); font-size: 17px; }
  .v0-top-end { margin-left: auto; }

  .cx-v0 .cx-tag { top: 104px; }

  .v0-hero { flex: 3 1 auto; min-height: 0; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr) 520px; align-items: center; column-gap: 64px; padding: 34px 72px; background: var(--cx-tint); }
  .v0-kicker { display: flex; align-items: center; gap: 16px; margin-bottom: 24px; min-width: 0; }
  .v0-chip { flex: none; max-width: 300px; padding: 6px 15px 7px; border-radius: 999px; background: #fff; box-shadow: inset 0 0 0 1px var(--cx-line); color: var(--cx-dark); font-size: 15px; font-weight: 600; }
  .v0-where { display: flex; align-items: center; gap: 7px; min-width: 0; color: var(--cx-muted); font-size: 15.5px; }
  .v0-where .cx-ico { color: var(--cx-primary); font-size: 17px; }
  .v0-h1 { max-width: 690px; padding-bottom: 6px; color: var(--cx-dark); font-weight: 700; }
  .v0-h1-xl { font-size: 78px; line-height: 1.03; letter-spacing: -.028em; }
  .v0-h1-l { font-size: 62px; line-height: 1.06; letter-spacing: -.024em; }
  .v0-h1-m { font-size: 50px; line-height: 1.1; letter-spacing: -.02em; }
  .v0-sub { max-width: 560px; margin-top: 20px; color: var(--cx-body); font-size: 21px; line-height: 1.5; }
  .v0-sub-long { font-size: 18.5px; }
  .v0-actions { display: flex; align-items: center; gap: 28px; margin-top: 32px; }
  .v0-link-call { display: flex; align-items: center; gap: 10px; min-width: 0; color: var(--cx-dark); font-size: 18.5px; font-weight: 600; }
  .v0-link-call .cx-ico { color: var(--cx-primary); font-size: 20px; }

  .v0-art { position: relative; width: 520px; height: 436px; }
  .v0-shop { width: 520px; height: 436px; }
  .v0-sign { fill: #fff; font-size: 40px; font-weight: 700; letter-spacing: .04em; }
  .v0-photo-back { position: absolute; left: 34px; top: 30px; right: -16px; bottom: -16px; border-radius: 30px; background: var(--cx-accent); }
  .v0-photo-frame { position: absolute; inset: 0 18px 18px 0; border-radius: 30px; overflow: hidden; background: var(--cx-dark); box-shadow: 0 24px 50px -28px rgba(20, 24, 40, .6); }
  .v0-toast { position: absolute; left: -60px; bottom: -16px; display: flex; align-items: center; gap: 14px; padding: 15px 22px 15px 15px; border-radius: 16px; background: #fff; box-shadow: 0 18px 40px -18px rgba(20, 24, 40, .45), 0 0 0 1px rgba(20, 24, 40, .06); }
  .v0-toast-mark { flex: none; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--cx-accent); color: var(--cx-dark); font-size: 22px; }
  .v0-toast-title { font-size: 16.5px; font-weight: 600; line-height: 1.25; }
  .v0-toast-sub { color: var(--cx-muted); font-size: 14px; line-height: 1.3; }

  .v0-services { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; justify-content: center; padding: 30px 72px; }
  .v0-h2 { font-size: 34px; font-weight: 700; line-height: 1.15; letter-spacing: -.02em; color: var(--cx-dark); }
  .v0-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; margin-top: 20px; }
  .v0-cards-1 { grid-template-columns: minmax(0, 420px); }
  .v0-cards-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .v0-card { padding: 24px 28px 22px; border-radius: 22px; background: #fff; box-shadow: inset 0 0 0 1px var(--cx-line); min-width: 0; }
  .v0-mark { position: relative; width: 50px; height: 50px; border-radius: 15px; background: var(--cx-tint); overflow: hidden; }
  .v0-mark::before, .v0-mark::after { content: ""; position: absolute; }
  .v0-mark-1::before { left: 11px; top: 11px; width: 28px; height: 28px; border-radius: 50%; background: var(--cx-primary); }
  .v0-mark-1::after { left: 21px; top: 21px; width: 8px; height: 8px; border-radius: 50%; background: var(--cx-tint); }
  .v0-mark-2::before { left: 10px; top: 10px; width: 20px; height: 20px; border-radius: 6px; background: var(--cx-primary); }
  .v0-mark-2::after { left: 20px; top: 20px; width: 20px; height: 20px; border-radius: 6px; background: var(--cx-accent); }
  .v0-mark-3::before { left: 11px; top: 25px; width: 28px; height: 14px; border-radius: 0 0 14px 14px; background: var(--cx-primary); }
  .v0-mark-3::after { left: 11px; top: 11px; width: 28px; height: 14px; border-radius: 14px 14px 0 0; background: var(--cx-accent); }
  .v0-card-title { margin-top: 16px; font-size: 22px; font-weight: 600; line-height: 1.22; letter-spacing: -.01em; }
  .v0-card-text { margin-top: 7px; color: var(--cx-muted); font-size: 16px; line-height: 1.5; }
  .v0-card-more { margin-top: 12px; color: var(--cx-primary); font-size: 16px; font-weight: 600; }

  .v0-reviews { flex: 0 0 auto; display: flex; align-items: center; gap: 64px; padding: 28px 72px; background: var(--cx-dark); color: #fff; }
  .v0-score { flex: none; }
  .v0-score-num { font-size: 72px; font-weight: 700; line-height: 1; letter-spacing: -.03em; }
  .v0-score .cx-stars { margin-top: 12px; }
  .v0-score-sub { margin-top: 10px; color: rgba(255, 255, 255, .84); font-size: 16.5px; }
  .v0-quotes { flex: 1 1 auto; min-width: 0; }
  .v0-quotes-title { font-size: 24px; font-weight: 600; letter-spacing: -.01em; }
  .v0-quote-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-top: 16px; }
  .v0-reviews .cx-quote { background: rgba(255, 255, 255, .06); border-color: rgba(255, 255, 255, .36); }

  .v0-contact { flex: 1 1 auto; min-height: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-content: center; align-items: center; column-gap: 32px; padding: 28px 72px; background: var(--cx-tint); }
  .v0-contact-solo { grid-template-columns: minmax(0, 1fr); }
  .v0-intro { padding-right: 40px; min-width: 0; }
  .v0-intro-title { font-size: 44px; font-weight: 700; line-height: 1.1; letter-spacing: -.024em; color: var(--cx-dark); }
  .v0-intro-text { max-width: 480px; margin-top: 14px; color: var(--cx-body); font-size: 19px; }
  .v0-details { margin-top: 26px; }
  .v0-detail { display: flex; align-items: flex-start; gap: 13px; font-size: 19px; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
  .v0-detail + .v0-detail { margin-top: 13px; }
  .v0-detail .cx-ico { margin-top: 3px; color: var(--cx-primary); font-size: 21px; }
  .v0-intro .cx-btn { margin-top: 28px; }
  .v0-panel { align-self: stretch; padding: 28px 32px; border-radius: 24px; background: #fff; box-shadow: inset 0 0 0 1px var(--cx-line); min-width: 0; }
  .v0-panel-title { font-size: 27px; font-weight: 700; line-height: 1.2; letter-spacing: -.015em; }
  .v0-panel-text { margin-top: 4px; color: var(--cx-muted); font-size: 16.5px; }
  .v0-days { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; margin-top: 18px; }
  .v0-slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 12px; }
  .v0-chosen { display: flex; align-items: center; gap: 12px; height: 50px; margin-top: 12px; padding: 0 16px; border-radius: 12px; background: var(--cx-tint); color: var(--cx-dark); font-size: 16px; font-weight: 600; }
  .v0-chosen .cx-ico { color: var(--cx-primary); font-size: 20px; }
  .v0-panel .cx-btn { margin-top: 18px; }
  .v0-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 18px; }
  .v0-fields .cx-field-tall { grid-column: 1 / -1; height: 104px; }

  .v0-foot { flex: none; min-height: 100px; display: flex; align-items: center; gap: 48px; padding: 16px 72px; background: var(--cx-dark); color: #fff; }
  .v0-foot-chat { padding-right: 190px; }
  .v0-foot .v0-brand { flex: 1 1 auto; }
  .v0-foot .cx-mono { background: #fff; color: var(--cx-dark); }
  .v0-foot-name { max-width: 560px; font-size: 19px; font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; }
  .v0-foot-item { display: flex; align-items: center; gap: 10px; flex: 0 1 auto; min-width: 0; color: rgba(255, 255, 255, .9); font-size: 16px; }
  .v0-foot-item .cx-ico { font-size: 18px; opacity: .7; }
  .v0-foot-addr { max-width: 400px; line-height: 1.35; overflow-wrap: anywhere; }
  .v0-foot-phone { flex: none; white-space: nowrap; font-weight: 600; }
</style>
<div class="cx cx-v0" style="{{ ui.palette(cx) }}">
  {{ ui.tag(cx) }}

  <div class="v0-top">
    <div class="v0-brand">
      {{ ui.mono(cx) }}
      {% if cx_name %}
      <div class="v0-name cx-one-line">{{ cx_name }}</div>
      {% endif %}
    </div>
    {% if cx_nav %}
    <div class="v0-nav">
      {% for n in cx_nav %}
      <div class="cx-one-line">{{ n }}</div>
      {% endfor %}
    </div>
    {% endif %}
    {% if cxf.tap_to_call %}
    <div class="v0-call{% if not cx_nav %} v0-top-end{% endif %}">{{ ui.icon('phone') }}<span class="cx-one-line">{{ cx_call }}</span></div>
    {% endif %}
  </div>

  <div class="v0-hero">
    <div>
      {% if cx.category or cx.address %}
      <div class="v0-kicker">
        {% if cx.category %}
        <div class="v0-chip cx-one-line">{{ cx.category }}</div>
        {% endif %}
        {% if cx.address %}
        <div class="v0-where">{{ ui.icon('pin') }}<span class="cx-one-line">{{ cx.address }}</span></div>
        {% endif %}
      </div>
      {% endif %}
      <div class="v0-h1 v0-h1-{{ cx_hsize }} cx-clamp-3">{{ cx_headline }}</div>
      <div class="v0-sub{% if cx_sub_long %} v0-sub-long{% endif %} cx-clamp-3">{{ cx_sub }}</div>
      <div class="v0-actions">
        <div class="cx-btn">{{ cx_cta }}</div>
        {% if cxf.tap_to_call %}
        <div class="v0-link-call">{{ ui.icon('phone') }}<span class="cx-one-line">{% if cx.phone %}Call {{ cx.phone }}{% else %}Call us{% endif %}</span></div>
        {% endif %}
      </div>
    </div>
    <div class="v0-art">
      {% if cx_photo %}
      <div class="v0-photo-back"></div>
      <div class="v0-photo-frame"><img class="cx-photo" src="{{ cx_photo }}" alt=""></div>
      {% else %}
      <svg class="v0-shop" viewBox="0 0 560 470" aria-hidden="true">
        <circle class="cx-f-primary" cx="290" cy="238" r="214" opacity=".13"/>
        <circle class="cx-f-accent" cx="486" cy="96" r="30"/>
        <rect class="cx-f-dark" x="50" y="330" width="8" height="98"/>
        <circle class="cx-f-accent" cx="54" cy="312" r="40"/>
        <rect class="cx-f-white" x="100" y="130" width="368" height="298" rx="12"/>
        <rect class="cx-f-dark" x="100" y="196" width="368" height="34" opacity=".1"/>
        <rect class="cx-f-dark" x="180" y="58" width="208" height="80" rx="16"/>
        <text class="v0-sign" x="284" y="112" text-anchor="middle">{{ cx.initials }}</text>
        <path class="cx-f-primary" d="M88 150h56v48a28 28 0 0 1-56 0z"/>
        <path class="cx-f-white" d="M144 150h56v48a28 28 0 0 1-56 0z"/>
        <path class="cx-f-primary" d="M200 150h56v48a28 28 0 0 1-56 0z"/>
        <path class="cx-f-white" d="M256 150h56v48a28 28 0 0 1-56 0z"/>
        <path class="cx-f-primary" d="M312 150h56v48a28 28 0 0 1-56 0z"/>
        <path class="cx-f-white" d="M368 150h56v48a28 28 0 0 1-56 0z"/>
        <path class="cx-f-primary" d="M424 150h56v48a28 28 0 0 1-56 0z"/>
        <rect class="cx-f-dark" x="84" y="140" width="400" height="14" rx="7"/>
        <rect class="cx-f-tint cx-s-dark" x="136" y="262" width="150" height="106" rx="8" stroke-width="6"/>
        <rect class="cx-f-dark" x="208" y="262" width="6" height="106"/>
        <circle class="cx-f-accent" cx="166" cy="372" r="15"/>
        <circle class="cx-f-primary" cx="194" cy="368" r="15"/>
        <circle class="cx-f-accent" cx="226" cy="372" r="15"/>
        <circle class="cx-f-primary" cx="256" cy="368" r="15"/>
        <rect class="cx-f-dark" x="130" y="378" width="162" height="24" rx="6"/>
        <path class="cx-f-dark" d="M326 428V300a52 52 0 0 1 104 0v128z"/>
        <path class="cx-f-tint" d="M342 352v-52a36 36 0 0 1 72 0v52z"/>
        <circle class="cx-f-accent" cx="412" cy="382" r="7"/>
        <rect class="cx-f-primary" x="492" y="372" width="34" height="56" rx="8"/>
        <rect class="cx-f-white" x="500" y="386" width="18" height="5" rx="2.5"/>
        <rect class="cx-f-dark" x="30" y="426" width="510" height="10" rx="5"/>
      </svg>
      {% endif %}
      {% if cxf.booking or cxf.enquiry_form %}
      <div class="v0-toast">
        <div class="v0-toast-mark">{{ ui.icon('check') }}</div>
        <div>
          {% if cxf.booking %}
          <div class="v0-toast-title">Booking confirmed</div>
          <div class="v0-toast-sub">A reminder goes out before the visit</div>
          {% else %}
          <div class="v0-toast-title">Enquiry sent</div>
          <div class="v0-toast-sub">It goes straight to the team</div>
          {% endif %}
        </div>
      </div>
      {% endif %}
    </div>
  </div>

  {% if cx_services %}
  <div class="v0-services">
    <div class="v0-h2">What we do</div>
    <div class="v0-cards v0-cards-{{ cx_services|length }}">
      {% for s in cx_services %}
      <div class="v0-card">
        <div class="v0-mark v0-mark-{{ loop.index }}"></div>
        <div class="v0-card-title cx-clamp-2">{{ s }}</div>
        <div class="v0-card-text">{{ cx_lines[loop.index0] }}</div>
        <div class="v0-card-more">Find out more</div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if cxf.reviews %}
  <div class="v0-reviews">
    {% if cx_has_rating %}
    <div class="v0-score">
      <div class="v0-score-num">{{ '%.1f'|format(cx.rating) }}</div>
      {{ ui.stars(cx.rating) }}
      <div class="v0-score-sub">{{ ui.review_count(cx) }}</div>
    </div>
    {% endif %}
    <div class="v0-quotes">
      <div class="v0-quotes-title">Your customer reviews</div>
      <div class="v0-quote-row">{{ ui.quote() }}{{ ui.quote() }}{{ ui.quote() }}</div>
    </div>
  </div>
  {% endif %}

  <div class="v0-contact{% if not (cxf.booking or cxf.enquiry_form) %} v0-contact-solo{% endif %}">
    {% if not two_panels %}
    <div class="v0-intro">
      <div class="v0-intro-title">{{ 'Get in touch' if cxf.enquiry_form or not cxf.booking else 'Book a visit' }}</div>
      <div class="v0-intro-text">
        {% if cxf.enquiry_form %}
        Send a message and it reaches the team straight away.
        {% elif cxf.booking %}
        Choose a day and a time, and the visit is booked.
        {% else %}
        We are glad to answer any question.
        {% endif %}
      </div>
      {% if cx.phone or cx.address %}
      <div class="v0-details">
        {% if cx.phone %}
        <div class="v0-detail">{{ ui.icon('phone') }}<span>{{ cx.phone }}</span></div>
        {% endif %}
        {% if cx.address %}
        <div class="v0-detail">{{ ui.icon('pin') }}<span class="cx-clamp-2">{{ cx.address }}</span></div>
        {% endif %}
      </div>
      {% endif %}
      {% if not (cxf.booking or cxf.enquiry_form) %}
      <div class="cx-btn">Get in touch</div>
      {% endif %}
    </div>
    {% endif %}
    {% if cxf.booking %}
    <div class="v0-panel">
      <div class="v0-panel-title">Book online</div>
      <div class="v0-panel-text">Pick a day and a time that suits you.</div>
      <div class="v0-days">{{ ui.days() }}</div>
      <div class="v0-slots">{{ ui.slots() }}</div>
      <div class="v0-chosen">{{ ui.icon('check') }}<span>Wednesday, around midday</span></div>
      <div class="cx-btn cx-btn-sm">Confirm booking</div>
    </div>
    {% endif %}
    {% if cxf.enquiry_form %}
    <div class="v0-panel">
      <div class="v0-panel-title">Send an enquiry</div>
      <div class="v0-panel-text">Tell us what you need and we will get back to you.</div>
      <div class="v0-fields">
        <div class="cx-field">Your name</div>
        <div class="cx-field">Phone number</div>
        <div class="cx-field cx-field-tall">How can we help?</div>
      </div>
      <div class="cx-btn cx-btn-sm">Send enquiry</div>
    </div>
    {% endif %}
  </div>

  <div class="v0-foot{% if cxf.chat %} v0-foot-chat{% endif %}">
    <div class="v0-brand">
      {{ ui.mono(cx) }}
      {% if cx_name %}
      <div class="v0-foot-name cx-clamp-2">{{ cx_name }}</div>
      {% endif %}
    </div>
    {% if cx.address %}
    <div class="v0-foot-item">{{ ui.icon('pin') }}<span class="v0-foot-addr cx-clamp-2">{{ cx.address }}</span></div>
    {% endif %}
    {% if cx.phone %}
    <div class="v0-foot-item v0-foot-phone">{{ ui.icon('phone') }}<span>{{ cx.phone }}</span></div>
    {% endif %}
  </div>

  {{ ui.chat(cxf) }}
</div>
